# ─────────────────────────────────────────────────────────────────────────────
# .env.build - Dùng riêng cho việc build Docker images
# ─────────────────────────────────────────────────────────────────────────────

# Tag image cần build và push (được sử dụng bởi docker-compose.build.yml)
IMAGE_TAG=uat-16072026

# ==============================================================================
# CẤU HÌNH FRONTEND BUILD ARGUMENTS
# ==============================================================================
# Nếu deploy chung 1 domain và dùng nginx nội bộ của frontend để proxy sang backend:
# Hãy để trống VITE_API_URL và VITE_SOCKET_URL. Frontend sẽ tự động dùng /api 
# và Nginx proxy_pass vào backend:3000.
VITE_API_URL=
VITE_SOCKET_URL=
VITE_APP_NAME="THISO Leasing Platform"

# (Chỉ dùng khi) tách backend sang subdomain riêng hoàn toàn độc lập với frontend:
# VITE_API_URL=https://api.thiso.com.vn
# VITE_SOCKET_URL=https://api.thiso.com.vn
