# THISO Leasing Platform - Docker Environment Variables
# Copy to .env for production deployment: cp .env.docker .env

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=leasing
POSTGRES_PASSWORD=leasing123
POSTGRES_DB=leasing_platform
DB_PORT=5432

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PORT=6379

# ===========================================
# Backend Configuration
# ===========================================
BACKEND_PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# Frontend Configuration
# ===========================================
FRONTEND_PORT=8080
# Leave empty to use relative /api path (proxied by nginx)
VITE_API_URL=

# ===========================================
# Security & Production
# ===========================================
# Set to true only in development — disables public /auth/register in production
ALLOW_PUBLIC_REGISTER=false
# Set to true only for initial setup / dev — never on production after go-live
SEED_DATABASE=false

# ===========================================
# Email (SMTP) — optional
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=THISO Leasing <noreply@thiso.com.vn>

# ===========================================
# Timezone
# ===========================================
TZ=Asia/Ho_Chi_Minh
