# THISO Leasing Platform — Root Environment Variables
# Copy this file to .env: cp .env.example .env
# Then copy apps/backend/.env.example to apps/backend/.env

# ============================================================
# PostgreSQL — used by docker-compose postgres service
# ============================================================
POSTGRES_USER=leasing
POSTGRES_PASSWORD=leasing123
POSTGRES_DB=leasing_platform
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=3000
FRONTEND_PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
VITE_API_URL=
ALLOW_PUBLIC_REGISTER=false
SEED_DATABASE=false
