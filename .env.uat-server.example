# THISO Leasing Platform — UAT Server Environment Variables
# Copy to .env.uat-server for local reference use ONLY if you need it — the
# actual UAT server keeps its own /home/leasing-platform/.env (see
# deploy-uat.sh); this file should never hold real values. See
# docs/security/SECRET_INCIDENT_REMEDIATION.md for why this template exists.

IMAGE_TAG=
NODE_ENV=production
TZ=Asia/Ho_Chi_Minh

POSTGRES_USER=leasing
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=leasing_platform

JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://uat.example.com

ALLOW_PUBLIC_REGISTER=false
SEED_DATABASE=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=THISO Leasing <noreply@thiso.com.vn>

ANTHROPIC_API_KEY=
