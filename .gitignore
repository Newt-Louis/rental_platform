# ─── Deploy Scripts (chứa credentials) ──────────────────────────────────────
deploy-uat.sh
deploy-uat.sh.*
deploy-prod.sh
deploy-prod.sh.*

# ─── Environment / Secrets ─────────────────────────────────────────────────
.env
.env.local
.env.production
.env.uat-server
apps/backend/.env
apps/backend/.env.local
apps/backend/.env.production
# Keep example files (no real credentials)
!.env.example
!.env.docker
!.env.uat-server.example
!apps/backend/.env.example

# ─── Secret incident 2026-08-19 (docs/security/SECRET_INCIDENT_REMEDIATION.md) ──
# artifacts/uat-preflight.env and the UAT DB dumps were committed with real
# credentials/data — untracked as part of remediation. Real database backups
# belong in a proper backup store (see docs/readiness/BACKUP_RESTORE_READINESS.md),
# never in git.
artifacts/uat-preflight.env
!artifacts/uat-preflight.env.example
artifacts/backups/*.dump
artifacts/backups/*.dump.json
artifacts/backups/*.dump.sha256
# Go-Live Workstream C (docs/golive/GO_LIVE_BLOCKERS.md GL-03): uploaded-file backup
# archives contain real tenant business documents — never belong in git, same reasoning
# as the DB dumps above.
artifacts/backups/*.tar.gz
artifacts/backups/*.tar.gz.json
artifacts/backups/*.tar.gz.sha256

# ─── Node Modules ────────────────────────────────────────────────────────────
node_modules/
apps/backend/node_modules/
apps/frontend/node_modules/
packages/*/node_modules/

# ─── Build Outputs ───────────────────────────────────────────────────────────
apps/backend/dist/
apps/frontend/dist/

# ─── Uploads (user data, not source code) ────────────────────────────────────
uploads/
apps/backend/uploads/

# ─── Docker volumes / local data ─────────────────────────────────────────────
docker/postgres-data*/
docker/redis-data/
*.log

# ─── Binary / Large files (keep in Google Drive / SharePoint) ────────────────
*.pdf
*.pptx
*.xlsx
*.xls
*.docx
*.doc

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.swp
*.swo

# ─── Test artifacts ──────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Prisma generated ────────────────────────────────────────────────────────
apps/backend/prisma/migrations/.DS_Store

.agents/
.agents/*
.codex/
.codex/*
