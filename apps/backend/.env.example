# THISO Leasing Platform Backend — Environment Variables
# Copy to .env: cp .env.example .env

# ============================================================
# Database
# For local dev: change host to 'localhost'
# For Docker: host is 'postgres' (service name in compose)
# ============================================================
DATABASE_URL=postgresql://leasing:leasing123@localhost:5432/leasing_platform

# ============================================================
# JWT Authentication
# Change JWT_SECRET to a strong random value in production!
# ============================================================
JWT_SECRET=thiso-leasing-super-secret-jwt-change-me-in-production
JWT_EXPIRES_IN=7d

# ============================================================
# Server
# ============================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ============================================================
# Email (SMTP) — optional; in-app notifications work without it
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Keep certificate verification enabled. Set false only for an explicitly trusted
# development SMTP relay with a self-signed certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=THISO Leasing <noreply@thiso.com.vn>
EMAIL_TIMEOUT_MS=15000
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_MS=250

# ============================================================
# Parking Dashboard (read-only integration, populated by an external sync process)
# Second Prisma client — schema at prisma/parking/schema.prisma.
# Run `npm run prisma:parking:pull` once this URL points at a real server.
# Remote DB lives at 125.234.136.82:5433 (sync-parking), reached via SSH tunnel:
#   ssh -N -L 15433:localhost:5433 root@125.234.136.82
# ============================================================
PARKING_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASS@localhost:15433/sync-parking?schema=public

# SAP resilience
SAP_ENABLED=false
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_TIMEOUT_MS=15000
SAP_MAX_ATTEMPTS=3
SAP_RETRY_BASE_MS=250
SAP_CIRCUIT_FAILURE_THRESHOLD=5
SAP_CIRCUIT_COOLDOWN_MS=60000
