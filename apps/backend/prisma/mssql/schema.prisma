// Second Prisma client - read-only external MSSQL database (not owned/migrated by this project).
// Models are empty until introspected from the real server:
//   npm run prisma:mssql:pull      (prisma db pull - fills in models from the live DB)
//   npm run prisma:mssql:generate  (regenerate the client after pulling/editing models)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../../node_modules/.prisma/mssql-client"
}

datasource db {
  provider = "sqlserver"
  url      = env("MSSQL_DATABASE_URL")
}

// Placeholder so `prisma generate` has a model to build against before the first
// `prisma db pull` - introspection replaces this file's models entirely, so it's safe.
model MssqlPlaceholder {
  id Int @id
}
