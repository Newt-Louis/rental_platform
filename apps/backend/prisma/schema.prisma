// Document hub tp trung -- thay th ri rc ContractFile, FitoutDocument
model UnifiedDocument {
  id            String    @id @default(cuid())
  mallId        String?
  mall          Mall?     @relation(fields: [mallId], references: [id])
  entityType    String // 'CONTRACT' | 'FITOUT' | 'TENANT' | 'INVOICE' | 'TICKET' | 'PROPOSAL'
  entityId      String
  category      String    @default("GENERAL") // 'ORIGINAL' | 'SCAN' | 'AMENDMENT' | 'CORRESPONDENCE' | 'SIGNED'
  documentType  String // loi ti liu c th
  fileName      String
  filePath      String
  fileHash      String? // SHA-256  verify integrity
  fileSize      Int       @default(0)
  mimeType      String    @default("application/octet-stream")
  version       Int       @default(1)
  isLatest      Boolean   @default(true)
  retentionYear Int       @default(10)
  deleteAfter   DateTime?
  signedAt      DateTime?
  signedBy      String?
  uploadedById  String
  uploadedBy    User      @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt    DateTime  @default(now())
  downloadCount Int       @default(0)
  isActive      Boolean   @default(true)

  @@index([entityType, entityId])
  @@index([mallId, documentType])
  @@index([uploadedAt])
}

// Mapping entity trong h thng sang i tng tng ng trong SAP
