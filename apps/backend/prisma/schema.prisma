  contractId  String
  contract    Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  period      String
  periodStart DateTime
  periodEnd   DateTime
  rentAmount  Float
  camAmount   Float
  subtotal    Float
  dueDate     DateTime
  status      BillingScheduleStatus @default(PENDING)
  invoiceId   String?               @unique
  invoice     Invoice?              @relation(fields: [invoiceId], references: [id])
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([contractId, period])
  @@index([status, dueDate])
}

model ContractFile {
  id           String    @id @default(cuid())
  contractId   String
  contract     Contract  @relation(fields: [contractId], references: [id])
  fileName     String
  filePath     String
  fileType     String?
  fileSize     Int?
  uploadedById String?
  sha256Hash   String?
  signedAt     DateTime?
  signerName   String?
  signerRole   String?
  verifyCode   String?   @unique
  createdAt    DateTime  @default(now())
}

/// Service and operations contracts, separate from leasing Contract records.
model ServiceContract {
  id                    String                @id @default(cuid())
  contractNumber        String                @unique
  title                 String
  mallId                String
  counterpartyName      String
  counterpartyTax       String?
  counterpartyEmail     String?
  counterpartyPhone     String?
  type                  ServiceContractType   @default(SERVICE)
  status                ServiceContractStatus @default(DRAFT)
  workflowStage         String?
  workflowColor         String?
  signedDate            DateTime?
  startDate             DateTime?
  endDate               DateTime?
  terminatedDate        DateTime?
  totalValue            Float                 @default(0)
  currency              String                @default("VND")
  paymentDirection      String                @default("PAYABLE")
  billingPartyId        String?
  billingParty          BillingParty?         @relation(fields: [billingPartyId], references: [id])
  invoiceLeadDays       Int                   @default(7)
  defaultVatRate        Float                 @default(10)
  paymentTermDays       Int                   @default(15)
  productName           String?
  riskScore             Int                   @default(0)
  hasAllRequiredClauses Boolean               @default(false)
  ownerId               String?
  createdById           String
  parentContractId      String?
  parentContract        ServiceContract?      @relation("ServiceContractRenewals", fields: [parentContractId], references: [id])
  renewals              ServiceContract[]     @relation("ServiceContractRenewals")
  notes                 String?
  tags                  String?
  isDeleted             Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  documents  ServiceContractDocument[]
  events     ServiceContractEvent[]
  payments   ServiceContractPayment[]
  checklist  ServiceContractChecklistItem[]
  milestones ServiceContractMilestone[]

  @@index([mallId, status])
  @@index([mallId, isDeleted, status, type, paymentDirection])
  @@index([endDate])
  @@index([counterpartyName])
}

model ServiceContractDocument {
  id           String                  @id @default(cuid())
  contractId   String
  contract     ServiceContract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  documentType String                  @default("CONTRACT")
  paymentId    String?
  payment      ServiceContractPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  version      Int                     @default(1)
  uploadedById String
  createdAt    DateTime                @default(now())

  @@index([contractId, documentType])
}

model ServiceContractPayment {
  id                     String                    @id @default(cuid())
  contractId             String
  contract               ServiceContract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone              String
  dueDate                DateTime
  amount                 Float
  currency               String                    @default("VND")
  status                 String                    @default("PENDING")
  paidDate               DateTime?
  paidAmount             Float?
  invoiceNumber          String?
  invoiceId              String?                   @unique
  invoice                Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  billingStatus          String                    @default("SCHEDULED")
  periodStart            DateTime?
  periodEnd              DateTime?
  invoicePlannedDate     DateTime?
  subtotal               Float?
  vatRate                Float?
  vatAmount              Float?
  totalAmount            Float?
  transferredToBillingAt DateTime?
  billingError           String?
  periodType             String?
  periodNumber           Int?
  reminderDays           Int                       @default(7)
  reminderSentAt         DateTime?
  notes                  String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  documents              ServiceContractDocument[]

  @@index([contractId, dueDate])
  @@index([status, dueDate])
}

model ServiceContractChecklistItem {
  id            String          @id @default(cuid())
  contractId    String
  contract      ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  isCompleted   Boolean         @default(false)
  completedAt   DateTime?
  completedById String?
  dueDate       DateTime?
  order         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([contractId, order])
}

model ServiceContractMilestone {
  id            String          @id @default(cuid())
  contractId    String
  contract      ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueDate       DateTime?
  status        String          @default("PENDING")
  completedAt   DateTime?
  completedById String?
  order         Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([contractId, order])
}

model ServiceContractEvent {
  id          String          @id @default(cuid())
  contractId  String
  contract    ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  eventType   String
  description String?
  oldValue    String?
  newValue    String?
  userId      String?
  createdAt   DateTime        @default(now())

  @@index([contractId, createdAt])
}

model FitoutProject {
  id                 String    @id @default(cuid())
  contractId         String    @unique
  contract           Contract  @relation(fields: [contractId], references: [id])
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  unitId             String
  unit               Unit      @relation(fields: [unitId], references: [id])
  status             String    @default("CONTRACT_SIGNED") // FK to FitoutStageConfig.code
  handoverDate       DateTime?
  startDate          DateTime?
  expectedOpenDate   DateTime?
  actualOpenDate     DateTime?
  operationManagerId String?
  operationManager   User?     @relation("OperationManaged", fields: [operationManagerId], references: [id])
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  checklists   FitoutChecklist[]
  documents    FitoutDocument[]
  milestones   FitoutMilestone[]
  contractors  FitoutContractor[]
  workerLogs   WorkerAccessLog[]
  submittals   FitoutSubmittal[]
  issues       FitoutIssue[]
  dailyReports FitoutDailyReportEntry[]
  tasks        FitoutTask[]
  risks        FitoutRisk[]
  changeOrders FitoutChangeOrder[]
}

model FitoutRisk {
  id              String        @id @default(cuid())
  projectId       String
  project         FitoutProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  riskNumber      String
  title           String
  description     String?
  category        String        @default("GENERAL")
  probability     Int
  impact          Int
  score           Int
  status          String        @default("OPEN")
  mitigationPlan  String?
  contingencyPlan String?
  ownerId         String?
  owner           User?         @relation("FitoutRiskOwner", fields: [ownerId], references: [id])
  dueDate         DateTime?
  closedAt        DateTime?
  createdById     String
  createdBy       User          @relation("FitoutRiskCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([projectId, riskNumber])
  @@index([projectId, status])
  @@index([projectId, score])
}

model FitoutChangeOrder {
  id                 String        @id @default(cuid())
  projectId          String
  project            FitoutProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeNumber       String
  title              String
  description        String?
  reason             String?
  status             String        @default("DRAFT")
  costType           String        @default("ADDITION")
  proposedAmount     Decimal       @default(0) @db.Decimal(18, 2)
  approvedAmount     Decimal?      @db.Decimal(18, 2)
  currency           String        @default("VND")
  scheduleImpactDays Int           @default(0)
  requestedById      String
  requestedBy        User          @relation("FitoutChangeRequestedBy", fields: [requestedById], references: [id])
  approvedById       String?
  approvedBy         User?         @relation("FitoutChangeApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  rejectedAt         DateTime?
  decisionNote       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([projectId, changeNumber])
  @@index([projectId, status])
}

// Cu hnh pipeline giai on fitout -- thay cho enum FitoutStatus cng.
// code gi nguyn cc gi tr enum c  tng thch d liu hin c.
model FitoutStageConfig {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  phaseGroup         String // Nhm giai on ln theo flowchart, vd "GD1_KHOI_DAU"
  roleColumn         String // OWNER | COORDINATOR | TENANT -- ct chu trch nhim chnh theo flowchart
  order              Int
  meetingRequired    Boolean  @default(false)
  triggersUnitStatus String? // UnitStatus cn chuyn khi vo stage ny, vd "UNDER_FITOUT"
  setsField          String? // Field trn FitoutProject cn set now(), vd "startDate" | "actualOpenDate"
  colorHex           String   @default("#6b7280")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, order])
}

// Danh mc loi Form/ti liu fitout -- thay cho enum FitoutDocumentType cng (ch 9 loi, khng  16 Form ca flowchart).
model FitoutFormType {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  category         String   @default("OTHER")
  defaultStageCode String?
  approvalLevels   Int      @default(1)
  approverRoles    Json? // mng Role theo th t cp duyt, vd ["OPERATION","MALL_DIRECTOR"] --  di phi khp approvalLevels
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  submittals FitoutSubmittal[]

  @@index([isActive, order])
}

//  trnh (Submittal) -- Form 1-16 theo flowchart, a cp duyt (ti dng ApprovalWorkflow/ApprovalStep).
model FitoutSubmittal {
  id                String            @id @default(cuid())
  projectId         String
  project           FitoutProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  formTypeId        String
  formType          FitoutFormType    @relation(fields: [formTypeId], references: [id])
  stageCode         String // stage ti thi im np (denormalized  gate-check tra cu nhanh)
  title             String
  revisionNo        Int               @default(1)
  parentSubmittalId String?
  parent            FitoutSubmittal?  @relation("SubmittalRevision", fields: [parentSubmittalId], references: [id])
  children          FitoutSubmittal[] @relation("SubmittalRevision")
  status            String            @default("SUBMITTED") // SUBMITTED | IN_PROGRESS | APPROVED | REJECTED | PUBLISHED | OBSOLETED
  workflowId        String?           @unique
  workflow          ApprovalWorkflow? @relation(fields: [workflowId], references: [id])
  submittedById     String
  submittedBy       User              @relation("SubmittalSubmittedBy", fields: [submittedById], references: [id])
  submittedAt       DateTime          @default(now())
  dueDate           DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([projectId, formTypeId])
  @@index([projectId, status])
}

// Vn /Khim khuyt (Defect/NCR) -- ghim v tr trn D-Map, workflow Opened->InProgress->Done->Closed/Reopened.
model FitoutIssue {
  id          String        @id @default(cuid())
  projectId   String
  project     FitoutProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit          @relation(fields: [unitId], references: [id])
  floorId     String?
  title       String
  description String?
  category    String        @default("DEFECT") // DEFECT | NCR | SAFETY | GENERAL
  severity    String        @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status      String        @default("OPENED") // OPENED | IN_PROGRESS | DONE | CLOSED | REOPENED | CANCELLED
  isOverdue   Boolean       @default(false)
  positionX   Float? // 0-100, to  trong bounding-box ca unit (ghim D-Map)
  positionY   Float?
  createdById String
  createdBy   User          @relation("IssueCreatedBy", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?         @relation("IssueAssignedTo", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  closedAt    DateTime?
  reopenCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectId, status])
  @@index([unitId, status])
}

// Bo co ngy (nht k cng trng in t) -- nhiu entry/ngy/nh thu, gp  tng c.
model FitoutDailyReportEntry {
  id             String            @id @default(cuid())
  projectId      String
  project        FitoutProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportDate     DateTime // ch ly phn ngy (00:00)  group theo ngy
  contractorId   String?
  contractor     FitoutContractor? @relation(fields: [contractorId], references: [id])
  workforceCount Int               @default(0)
  description    String
  areaTag        String? // khu vc trong mt bng, vd "Tng trt - khu A"
  createdById    String
  createdBy      User              @relation("DailyReportCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())

  @@index([projectId, reportDate])
}

// Tin  thi cng (Gantt) -- WBS cy con qua parentTaskId, planned/revised/actual.
model FitoutTask {
  id                   String            @id @default(cuid())
  projectId            String
  project              FitoutProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String
  parentTaskId         String?
  parent               FitoutTask?       @relation("TaskWbs", fields: [parentTaskId], references: [id])
  children             FitoutTask[]      @relation("TaskWbs")
  plannedStart         DateTime
  plannedEnd           DateTime
  revisedStart         DateTime?
  revisedEnd           DateTime?
  actualStart          DateTime?
  actualEnd            DateTime?
  percentComplete      Int               @default(0)
  isLate               Boolean           @default(false)
  sortOrder            Int               @default(0)
  assignedContractorId String?
  assignedContractor   FitoutContractor? @relation(fields: [assignedContractorId], references: [id])
  dependsOnTaskId      String?
  dependsOn            FitoutTask?       @relation("TaskDependency", fields: [dependsOnTaskId], references: [id])
  dependents           FitoutTask[]      @relation("TaskDependency")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([projectId, sortOrder])
}

// Comment/thread dng chung cho Submittal, Issue (Phase 3), ... -- polymorphic entityType/entityId.
model EntityComment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Distribution list dng chung cho Submittal, Issue (Phase 3), ... -- polymorphic entityType/entityId.
model EntityDistribution {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  notifiedAt DateTime?
  viewedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([entityType, entityId, userId])
  @@index([entityType, entityId])
}

model FitoutChecklist {
  id            String        @id @default(cuid())
  projectId     String
  project       FitoutProject @relation(fields: [projectId], references: [id])
  title         String
  description   String?
  isCompleted   Boolean       @default(false)
  completedById String?
  completedAt   DateTime?
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  unitId       String
  unit         Unit           @relation(fields: [unitId], references: [id])
  type         TicketType
  priority     TicketPriority @default(MEDIUM)
  sla          Int?
  slaDueAt     DateTime?
  subject      String
  description  String?
  createdById  String?
  createdBy    User?          @relation("TicketCreatedBy", fields: [createdById], references: [id])
  source       TicketSource   @default(STAFF_INSPECTION)
  assignedToId String?
  assignedTo   User?          @relation("AssignedTickets", fields: [assignedToId], references: [id])
  status       TicketStatus   @default(NEW)
  resolvedAt   DateTime?
  closedAt     DateTime?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  comments    TicketComment[]
  escalations TicketEscalation[]
  rating      TicketRating?

  @@index([slaDueAt, status])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Trng thi duyt doanh thu -- bn vng trn chnh bn ghi, khng ch nm trong audit trail.
enum SalesApprovalStatus {
  PENDING
  APPROVED
  DISPUTED
}

model SalesTurnover {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  unitId       String
  unit         Unit                @relation(fields: [unitId], references: [id])
  date         DateTime
  period       String
  grossSales   Float
  netSales     Float
  transactions Int                 @default(0)
  status       SalesApprovalStatus @default(PENDING)
  recordedById String?
  recordedBy   User?               @relation("RecordedBy", fields: [recordedById], references: [id])
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  auditTrail SalesAuditTrail[]

  @@unique([tenantId, unitId, period])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  contractId     String?
  contract       Contract?     @relation(fields: [contractId], references: [id])
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id])
  billingPartyId String?
  billingParty   BillingParty? @relation(fields: [billingPartyId], references: [id])
  sourceType     String        @default("LEASE_CONTRACT")
  sourceId       String?
  period         String
  type           InvoiceType   @default(MONTHLY_RENT)
  status         InvoiceStatus @default(DRAFT)
  subtotal       Float
  vatRate        Float         @default(10)
  vatAmount      Float
  totalAmount    Float
  dueDate        DateTime
  issuedAt       DateTime?
  paidAt         DateTime?
  notes          String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Hu ho n c kim sot -- khng xo bn ghi, ch nh du CANCELLED + lu vt ai/khi no/v sao.
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  voidReason String?

  lines                  InvoiceLine[]
  payments               Payment[]
  billingSchedule        BillingScheduleEntry?
  arDunningLogs          ArDunningLog[]
  serviceContractPayment ServiceContractPayment?

  @@index([sourceType, sourceId])
  @@index([billingPartyId, status, dueDate])
}

model BillingParty {
  id               String            @id @default(cuid())
  mallId           String?
  mall             Mall?             @relation(fields: [mallId], references: [id])
  tenantId         String?           @unique
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  name             String
  taxCode          String?
  email            String?
  phone            String?
  address          String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  serviceContracts ServiceContract[]
  invoices         Invoice[]
  payments         Payment[]

  @@index([mallId, isActive])
  @@index([taxCode])
}

model ArDunningPolicy {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  level          Int
  minDaysOverdue Int
  maxDaysOverdue Int?
  notifyTenant   Boolean  @default(true)
  notifyFinance  Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logs ArDunningLog[]

  @@index([isActive, level])
}

model ArDunningLog {
  id        String          @id @default(cuid())
  invoiceId String
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  policyId  String
  policy    ArDunningPolicy @relation(fields: [policyId], references: [id])
  level     Int
  sentAt    DateTime        @default(now())

  @@unique([invoiceId, policyId])
  @@index([invoiceId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  type        String
  description String
  qty         Float   @default(1)
  unitPrice   Float
  amount      Float
  order       Int     @default(0)
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  tenantId        String?
  tenant          Tenant?       @relation(fields: [tenantId], references: [id])
  billingPartyId  String?
  billingParty    BillingParty? @relation(fields: [billingPartyId], references: [id])
  amount          Float
  method          PaymentMethod @default(BANK_TRANSFER)
  reference       String?
  idempotencyKey  String?       @unique
  idempotencyHash String?
  paidAt          DateTime
  notes           String?
  createdAt       DateTime      @default(now())

  // o bt ton thanh ton ghi nhm -- khng xo bn ghi, ch nh du  o + lu vt.
  reversedAt     DateTime?
  reversedById   String?
  reversedBy     User?     @relation("PaymentReversedBy", fields: [reversedById], references: [id])
  reversalReason String?
}

model SapIntegrationLog {
  id             String    @id @default(cuid())
  entityType     String
  entityId       String
  endpoint       String
  payload        String
  response       String?
  status         SapStatus @default(PENDING)
  retryCount     Int       @default(0)
  errorMessage   String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model DealScoreCriterion {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  fieldSource String
  weight      Float    @default(1)
  minScore    Float    @default(0)
  maxScore    Float    @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProposalDealScore {
  id         String   @id @default(cuid())
  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  totalScore Float
  grade      String
  breakdown  Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContractTemplate {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  contractType ContractType @default(LEASE_AGREEMENT)
  content      String       @db.Text
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  clauses   ContractClause[]
  contracts Contract[]
}

model ContractClause {
  id         String           @id @default(cuid())
  templateId String
  template   ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  code       String
  title      String
  content    String           @db.Text
  order      Int              @default(0)
  isRequired Boolean          @default(true)
  createdAt  DateTime         @default(now())

  @@unique([templateId, code])
}

model ContractAmendment {
  id              String          @id @default(cuid())
  contractId      String
  contract        Contract        @relation(fields: [contractId], references: [id])
  amendmentNumber String          @unique
  type            AmendmentType
  status          AmendmentStatus @default(DRAFT)
  effectiveDate   DateTime
  changes         Json
  reason          String?
  submittedAt     DateTime?
  approvedAt      DateTime?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([contractId, status])
}

model ContractEvent {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  eventType   String
  title       String
  description String?
  beforeValue String?
  afterValue  String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([contractId, createdAt])
}

model PenaltyInterestPolicy {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  annualRate Float    @default(12)
  graceDays  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BillingConfig {
  id                  String   @id @default(cuid())
