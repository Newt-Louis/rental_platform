generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEASING_EXECUTIVE
  LEASING_MANAGER
  MALL_DIRECTOR
  FINANCE
  LEGAL
  OPERATION
  TENANT
  CEO
}

enum UnitStatus {
  VACANT       // Trống
  BOOKING      // Đang booking/giữ chỗ
  NEGOTIATING  // Đang thương thảo (proposal stage)
  CONTRACTED   // Đã ký hợp đồng, chờ thi công
  UNDER_FITOUT // Đang thi công
  OCCUPIED     // Đang thuê
}

enum BookingStatus {
  PENDING     // Mới tạo, chờ sale xác nhận
  ACTIVE      // Đang giữ slot (unit → BOOKING)
  EXPIRED     // Quá hạn hold
  CANCELLED   // Hủy thủ công
  CONVERTED   // Đã chuyển thành Proposal
}

enum UnitMediaType {
  PHOTO
  FLOOR_PLAN
  VIDEO
  RENDER_3D
  BROCHURE
  SITE_MAP
}

enum BookingActivityType {
  CREATED
  ACTIVATED
  PRIORITY_CHANGED
  EXTENDED
  NOTE_ADDED
  CONVERTED
  CANCELLED
  EXPIRED
}

enum LeadSource {
  BROKER
  WEBSITE
  REFERRAL
  WALK_IN
  EXISTING_TENANT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

enum CustomerStatus {
  PROSPECT
  NEGOTIATING
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  PROPOSAL_SENT
  NOTE
  OTHER
}

enum PriceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ═══════════════════════════════════════════════════════════════════════════
// CATEGORY MASTER DATA
// ═══════════════════════════════════════════════════════════════════════════

model Category {
  id          String      @id @default(cuid())
  code        String      @unique    // "FNB", "FASHION", "BEAUTY"
  name        String                 // "F&B", "Fashion", "Beauty & Wellness"
  description String?
  parentId    String?                // For sub-categories
  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  units             Unit[]
  tenants           Tenant[]
  leads             Lead[]
  customers         Customer[]
  categoryPricings  CategoryMallPricing[]

  @@index([code])
  @@index([parentId])
  @@index([isActive, sortOrder])
}

model CategoryMallPricing {
  id              String    @id @default(cuid())
  mallId          String
  mall            Mall      @relation(fields: [mallId], references: [id])
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  floorId         String?
  floor           Floor?    @relation(fields: [floorId], references: [id])
  zoneId          String?
  zone            Zone?     @relation(fields: [zoneId], references: [id])
  
  // Price range (VND/m²/month)
  minRentPerSqm   Float                 // Giá sàn
  maxRentPerSqm   Float                 // Giá trần
  suggestedRent   Float?                // Giá đề xuất (tham khảo)
  
  // CAM pricing
  camPerSqm       Float     @default(0) // Phí quản lý chuẩn
  
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?             // Null = vô thời hạn
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  createdBy       User?     @relation("CategoryPricingCreatedBy", fields: [createdById], references: [id])

  @@unique([mallId, categoryId, floorId, zoneId, effectiveFrom])
  @@index([mallId, categoryId, isActive])
  @@index([effectiveFrom, effectiveTo])
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ContractType {
  LOI
  LEASE_AGREEMENT
  APPENDIX
  RENEWAL
  TERMINATION
}

enum ContractStatus {
  DRAFT
  PENDING_LEGAL
  PENDING_SIGNATURE
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum AmendmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  APPLIED
}

enum AmendmentType {
  RENT_CHANGE
  TERM_EXTENSION
  RENT_FREE_CHANGE
  CAM_CHANGE
  RENEWAL
  OTHER
}

enum FitoutStatus {
  CONTRACT_SIGNED
  SUBMIT_DESIGN
  DESIGN_REVIEW
  FIRE_SAFETY_REVIEW
  CONSTRUCTION_PERMIT
  FITOUT_IN_PROGRESS
  INSPECTION
  APPROVED_TO_OPEN
  OPENED
}

enum TicketType {
  ELECTRICAL
  WATER
  HVAC
  CLEANING
  SECURITY
  PARKING
  INTERNET
  DELIVERY
  MARKETING_EVENT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_TENANT
  RESOLVED
  CLOSED
}

enum InvoiceType {
  MONTHLY_RENT
  DEPOSIT
  UTILITY
  MARKETING_FEE
  PARKING
  PENALTY
  REVENUE_SHARE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  ONLINE
}

enum SapStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  fullName      String
  role          Role      @default(LEASING_EXECUTIVE)
  phone         String?
  avatar        String?
  department    String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedLeads        Lead[]             @relation("AssignedLeads")
  approvalSteps        ApprovalStep[]
  ticketsAssigned      Ticket[]           @relation("AssignedTickets")
  auditLogs            AuditLog[]
  notifications        Notification[]
  managedContracts     Contract[]         @relation("ManagedContracts")
  fitoutProjects       FitoutProject[]    @relation("OperationManaged")
  recordedSales        SalesTurnover[]    @relation("RecordedBy")
  leadActivities       LeadActivity[]
  assignedCustomers    Customer[]         @relation("AssignedCustomers")
  createdCustomers     Customer[]         @relation("CreatedCustomers")
  customerActivities   CustomerActivity[] @relation("CustomerActivityBy")
  contractEvents       ContractEvent[]
  mallAccess           UserMallAccess[]
  followUpsAssigned    LeadFollowUp[]     @relation("FollowUpAssigned")
  uploadedDocuments    UnifiedDocument[]  @relation("DocumentUploadedBy")
  downloadedDocuments  DocumentDownloadLog[] @relation("DocumentDownloadBy")
  salesAudits          SalesAuditTrail[]  @relation("SalesAuditBy")
  announcements        MallAnnouncement[] @relation("AnnouncementCreatedBy")
  createdBookings      UnitBooking[]      @relation("BookingCreatedBy")
  assignedBookings     UnitBooking[]      @relation("BookingAssignedTo")
  approvedBookingPrices UnitBooking[]     @relation("BookingPriceApprover")
  bookingActivities    BookingActivity[]
  uploadedUnitMedia    UnitMedia[]
  unitHistoryChanges   UnitHistory[]      @relation("UnitHistoryChangedBy")
  slotBookings         SlotBooking[]      @relation("SlotBookedBy")
  categoryPricings     CategoryMallPricing[] @relation("CategoryPricingCreatedBy")
}

model Mall {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  address     String?
  city        String?
  totalArea   Float?
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  buildings            Building[]
  floors               Floor[]
  zones                Zone[]
  units                Unit[]
  floorPlans           FloorPlanAnalysis[]
  occupancySnapshots   OccupancySnapshot[]
  mallPolicy           MallPolicy?
  userAccess           UserMallAccess[]
  announcements        MallAnnouncement[]
  bankStatements       BankStatement[]
  maintenanceSchedules MaintenanceSchedule[]
  unifiedDocuments     UnifiedDocument[]
  categoryPricings     CategoryMallPricing[]
}

model Building {
  id        String    @id @default(cuid())
  mallId    String
  mall      Mall      @relation(fields: [mallId], references: [id])
  name      String
  code      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  floors    Floor[]
  zones     Zone[]
  units     Unit[]
}

model Floor {
  id             String    @id @default(cuid())
  mallId         String
  mall           Mall      @relation(fields: [mallId], references: [id])
  buildingId     String?
  building       Building? @relation(fields: [buildingId], references: [id])
  name           String
  level          String
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Digital Map — floor plan image for interactive map
  floorPlanUrl   String?   // URL/path of uploaded floor plan image
  floorPlanRatio Float?    // aspect ratio (width/height) stored for correct rendering

  zones             Zone[]
  units             Unit[]
  categoryPricings  CategoryMallPricing[]
}

model Zone {
  id         String    @id @default(cuid())
  mallId     String
  mall       Mall      @relation(fields: [mallId], references: [id])
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id])
  floorId    String?
  floor      Floor?    @relation(fields: [floorId], references: [id])
  name       String
  code       String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  units             Unit[]
  categoryPricings  CategoryMallPricing[]
}

model Unit {
  id              String     @id @default(cuid())
  mallId          String
  mall            Mall       @relation(fields: [mallId], references: [id])
  buildingId      String?
  building        Building?  @relation(fields: [buildingId], references: [id])
  floorId         String?
  floor           Floor?     @relation(fields: [floorId], references: [id])
  zoneId          String?
  zone            Zone?      @relation(fields: [zoneId], references: [id])
  code            String
  name            String?
  areaGFA         Float
  areaNLA         Float
  category        String?      // Legacy: free text category
  categoryId      String?      // NEW: FK to Category master
  categoryRef     Category?    @relation(fields: [categoryId], references: [id])
  baseRentPerSqm  Float      @default(0)
  camPerSqm       Float      @default(0)
  status          UnitStatus @default(VACANT)
  tenantId        String?
  tenant          Tenant?    @relation("OccupiedUnit", fields: [tenantId], references: [id])
  leaseStartDate  DateTime?
  leaseEndDate    DateTime?
  description     String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Phase 1 & 2: New pricing fields
  marketRentPerSqm  Float?        // Market reference rent
  askingRentPerSqm  Float?        // Asking rent (negotiable)
  escalationRate    Float?        // Annual escalation rate (%)
  minLeaseTerm      Int?          // Minimum lease term (months)
  maxLeaseTerm      Int?          // Maximum lease term (months)

  // Phase 1: Tracking fields
  vacantSince       DateTime?     // When unit became vacant
  lastRenovation    DateTime?     // Last renovation date
  condition         String?       // EXCELLENT, GOOD, FAIR, NEEDS_RENOVATION

  // Phase 2: Additional info
  features          Json?         // {ac: true, water: true, electricity: true, facing: 'N', corner: false}
  virtualTourUrl    String?       // 360° tour / video link

  // Digital Map — position on floor plan (% of image dimensions, 0-100)
  mapPosX           Float?        // left edge % (legacy rect mode)
  mapPosY           Float?        // top edge %
  mapPosW           Float?        // width %
  mapPosH           Float?        // height %
  mapPolygon        Json?         // [[x%, y%], ...] polygon vertices

  proposals            Proposal[]
  contracts            Contract[]
  fitoutProjects       FitoutProject[]
  tickets              Ticket[]
  salesTurnovers       SalesTurnover[]
  maintenanceSchedules MaintenanceSchedule[]
  bookings             UnitBooking[]
  media                UnitMedia[]
  history              UnitHistory[]
  slots                UnitSlot[]

  @@unique([mallId, code])
  @@index([mallId, status])
  @@index([floorId, status])
  @@index([status, areaNLA])
  @@index([leaseEndDate])
  @@index([status, updatedAt])
  @@index([category, status, mallId])
  @@index([vacantSince])
}

model Tenant {
  id             String    @id @default(cuid())
  companyName    String
  brandName      String
  taxCode        String?   @unique
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  category       String?      // Legacy: free text
  categoryId     String?      // NEW: FK to Category master
  categoryRef    Category?    @relation(fields: [categoryId], references: [id])
  logo           String?
  isPortalUser   Boolean   @default(false)
  portalEmail    String?   @unique
  portalPassword String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  occupiedUnits  Unit[]          @relation("OccupiedUnit")
  leads          Lead[]
  proposals      Proposal[]
  contracts      Contract[]
  fitoutProjects FitoutProject[]
  tickets        Ticket[]
  salesTurnovers SalesTurnover[]
  invoices       Invoice[]
  payments       Payment[]
  notifications  Notification[]
  customers      Customer[]
  deposits       DepositAccount[]
}

model Lead {
  id           String       @id @default(cuid())
  brandName    String
  company      String?
  contactName  String
  phone        String?
  email        String?
  category     String?      // Legacy: free text
  categoryId   String?      // NEW: FK to Category master
  categoryRef  Category?    @relation(fields: [categoryId], references: [id])
  source       LeadSource   @default(WALK_IN)
  status       LeadStatus   @default(NEW)
  priority     LeadPriority @default(WARM)
  assignedToId String?
  assignedTo   User?        @relation("AssignedLeads", fields: [assignedToId], references: [id])
  tenantId     String?
  tenant       Tenant?      @relation(fields: [tenantId], references: [id])
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  notes        String?
  expectedRent Float?
  expectedArea Float?
  estimatedValue    Float?
  expectedCloseDate DateTime?
  preferredCategory String?
  position          Int        @default(0)
  lastActivityAt    DateTime?
  lostReason        String?
  isActive     Boolean    @default(true)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  activities   LeadActivity[]
  proposals    Proposal[]
  contacts     LeadContact[]
  followUps    LeadFollowUp[]
  bookings     UnitBooking[]
  slotBookings SlotBooking[]

  @@index([status, priority, position])
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])
  type        String
  note        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Proposal {
  id                   String         @id @default(cuid())
  proposalNumber       String         @unique
  leadId               String?
  lead                 Lead?          @relation(fields: [leadId], references: [id])
  tenantId             String?
  tenant               Tenant?        @relation(fields: [tenantId], references: [id])
  unitId               String
  unit                 Unit           @relation(fields: [unitId], references: [id])
  area                 Float
  term                 Int
  startDate            DateTime
  endDate              DateTime?
  rentPerSqm           Float
  camPerSqm            Float          @default(0)
  deposit              Float          @default(3)
  rentFree             Int            @default(0)
  escalationPercent    Float          @default(0)
  revenueSharePercent  Float          @default(0)
  marketingFee         Float          @default(0)
  monthlyRent          Float
  monthlyCAM           Float
  depositAmount        Float
  totalContractValue   Float
  discount             Float          @default(0)
  status               ProposalStatus @default(DRAFT)
  notes                String?

  // Tờ Trình fields
  businessModel        String?        // Mô hình Kinh doanh (Gian hàng, Chuỗi, Kiosk...)
  serviceFeeSqm        Float          @default(0)   // Phí Dịch vụ (USD/m²/tháng)
  businessSupportFeeSqm Float         @default(0)   // Phí hỗ trợ Kinh doanh
  rentCurrency         String         @default("VND") // VND hoặc USD
  fitoutDays           Int            @default(90)  // Thời hạn hoàn thiện nội thất (ngày)
  handoverDate         DateTime?      // Ngày Bàn giao Mặt bằng
  openingDate          DateTime?      // Ngày Khai trương dự kiến
  specialConditions    String?        // Điều kiện đặc biệt (mục 21)
  editorContent        Json?          // Editor state: logo, font, color, item overrides, signatories

  createdById          String
  isActive             Boolean        @default(true)
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  bookingId            String?        @unique
  booking              UnitBooking?   @relation(fields: [bookingId], references: [id])
  approvalWorkflow     ApprovalWorkflow?
  contract             Contract?
  versions             ProposalVersion[]
  dealScore            ProposalDealScore?
  scenarios            ProposalScenario[]
  negotiations         ProposalNegotiationRound[]
}

model ProposalVersion {
  id           String   @id @default(cuid())
  proposalId   String
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  changeReason String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@unique([proposalId, version])
  @@index([proposalId])
}

model ApprovalWorkflow {
  id          String         @id @default(cuid())
  entityType  String
  entityId    String
  proposalId  String?        @unique
  proposal    Proposal?      @relation(fields: [proposalId], references: [id])
  status      WorkflowStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  steps       ApprovalStep[]
}

model ApprovalStep {
  id           String     @id @default(cuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  stepOrder    Int
  stepName     String
  approverRole Role
  approverId   String?
  approver     User?      @relation(fields: [approverId], references: [id])
  status       StepStatus @default(PENDING)
  comment      String?
  decidedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ApprovalPolicyRule {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  stepName      String
  stepOrder     Int
  approverRole  Role
  conditionType String
  operator      String?
  threshold     Float?
  matchValue    String?
  isRequired    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, stepOrder])
}

model Contract {
  id                String         @id @default(cuid())
  contractNumber    String         @unique
  proposalId        String?        @unique
  proposal          Proposal?      @relation(fields: [proposalId], references: [id])
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  unitId            String
  unit              Unit           @relation(fields: [unitId], references: [id])
  type              ContractType   @default(LEASE_AGREEMENT)
  status            ContractStatus @default(DRAFT)
  startDate         DateTime
  endDate           DateTime
  term              Int
  rent              Float
  cam               Float          @default(0)
  deposit           Float
  billingCycle      BillingCycle   @default(MONTHLY)
  paymentTerm       Int            @default(30)
  rentFree          Int            @default(0)
  escalationPercent Float          @default(0)
  managedById       String?
  managedBy         User?          @relation("ManagedContracts", fields: [managedById], references: [id])
  notes             String?
  isActive          Boolean        @default(true)
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  files             ContractFile[]
  fitoutProject     FitoutProject?
  invoices          Invoice[]
  billingSchedule   BillingScheduleEntry[]
  amendments        ContractAmendment[]
  events            ContractEvent[]
  templateId        String?
  template          ContractTemplate? @relation(fields: [templateId], references: [id])
  renewalRiskScore  RenewalRiskScore?
  termination       ContractTermination?
  depositAccount    DepositAccount?
}

enum BillingScheduleStatus {
  PENDING
  INVOICED
  SKIPPED
}

model BillingScheduleEntry {
  id          String                @id @default(cuid())
  contractId  String
  contract    Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  period      String
  periodStart DateTime
  periodEnd   DateTime
  rentAmount  Float
  camAmount   Float
  subtotal    Float
  dueDate     DateTime
  status      BillingScheduleStatus @default(PENDING)
  invoiceId   String?               @unique
  invoice     Invoice?              @relation(fields: [invoiceId], references: [id])
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([contractId, period])
  @@index([status, dueDate])
}

model ContractFile {
  id              String    @id @default(cuid())
  contractId      String
  contract        Contract  @relation(fields: [contractId], references: [id])
  fileName        String
  filePath        String
  fileType        String?
  fileSize        Int?
  uploadedById    String?
  sha256Hash      String?
  signedAt        DateTime?
  signerName      String?
  signerRole      String?
  verifyCode      String?   @unique
  createdAt       DateTime  @default(now())
}

model FitoutProject {
  id                 String       @id @default(cuid())
  contractId         String       @unique
  contract           Contract     @relation(fields: [contractId], references: [id])
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  unitId             String
  unit               Unit         @relation(fields: [unitId], references: [id])
  status             FitoutStatus @default(CONTRACT_SIGNED)
  handoverDate       DateTime?
  startDate          DateTime?
  expectedOpenDate   DateTime?
  actualOpenDate     DateTime?
  operationManagerId String?
  operationManager   User?        @relation("OperationManaged", fields: [operationManagerId], references: [id])
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  checklists         FitoutChecklist[]
  documents          FitoutDocument[]
  milestones         FitoutMilestone[]
  contractors        FitoutContractor[]
  workerLogs         WorkerAccessLog[]
}

model FitoutChecklist {
  id            String        @id @default(cuid())
  projectId     String
  project       FitoutProject @relation(fields: [projectId], references: [id])
  title         String
  description   String?
  isCompleted   Boolean       @default(false)
  completedById String?
  completedAt   DateTime?
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  unitId       String
  unit         Unit           @relation(fields: [unitId], references: [id])
  type         TicketType
  priority     TicketPriority @default(MEDIUM)
  sla          Int?
  slaDueAt     DateTime?
  subject      String
  description  String?
  assignedToId String?
