  pricePerDaySqm   Float?
  pricePerHour     Float?
  pricePerSqmMonth Float?
  posX             Float?    @default(10)
  posY             Float?    @default(10)
  posW             Float?    @default(20)
  posH             Float?    @default(20)
  fillColor        String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  pricingRules SlotPricingRule[]
  bookings     SlotBooking[]

  @@unique([unitId, code])
  @@index([unitId, isActive])
}

model SlotPricingRule {
  id          String    @id @default(cuid())
  slotId      String
  slot        UnitSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  name        String
  ruleType    String // WEEKEND, HOLIDAY, SEASONAL, MIN_DAYS
  multiplier  Float?    @default(1)
  discountPct Float?    @default(0)
  minDays     Int?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slotId, isActive])
}

model SlotBooking {
  id            String            @id @default(cuid())
  bookingRef    String            @unique
  slotId        String
  slot          UnitSlot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?             @relation(fields: [leadId], references: [id])
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id])
  type          String // DAILY, HOURLY, MONTHLY
  startDatetime DateTime
  endDatetime   DateTime
  totalArea     Float?
  baseAmount    Float?
  discountPct   Float?            @default(0)
  totalAmount   Float // Final amount after discount
  status        SlotBookingStatus @default(PENDING)
  notes         String?
  cancelReason  String?
  createdById   String?
  createdBy     User?             @relation("SlotBookedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([slotId, status])
  @@index([startDatetime, endDatetime])
}

// Cu hnh thng hiu hin th  mn hnh ng nhp (logo + nh nn) -- bng singleton,
// lun ch c 1 dng, service t to dng u tin nu cha c.
model BrandingSettings {
  id            String   @id @default(cuid())
  logoUrl       String?
  backgroundUrl String?
  updatedById   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}
