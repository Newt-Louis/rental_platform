model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  password           String
  fullName           String
  role               Role      @default(LEASING_EXECUTIVE)
  phone              String?
  avatar             String?
  department         String?
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  inviteTokenHash    String?
  inviteExpiresAt    DateTime?
  mustChangePassword Boolean   @default(false)

  // Lin kt ti khon ng nhp (role=TENANT) vi Tenant record tng ng -- ch c  ngha vi role TENANT.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Active mall selected by user -- null means view all (only meaningful for ADMIN/CEO).
  activeMallId String?
  activeMall   Mall?   @relation("UserActiveMall", fields: [activeMallId], references: [id])

  assignedLeads              Lead[]                     @relation("AssignedLeads")
  approvalSteps              ApprovalStep[]
  ticketsAssigned            Ticket[]                   @relation("AssignedTickets")
  auditLogs                  AuditLog[]
  notifications              Notification[]
  managedContracts           Contract[]                 @relation("ManagedContracts")
  fitoutProjects             FitoutProject[]            @relation("OperationManaged")
  recordedSales              SalesTurnover[]            @relation("RecordedBy")
  leadActivities             LeadActivity[]
  assignedCustomers          Customer[]                 @relation("AssignedCustomers")
  createdCustomers           Customer[]                 @relation("CreatedCustomers")
  customerActivities         CustomerActivity[]         @relation("CustomerActivityBy")
  contractEvents             ContractEvent[]
  mallAccess                 UserMallAccess[]
  followUpsAssigned          LeadFollowUp[]             @relation("FollowUpAssigned")
  uploadedDocuments          UnifiedDocument[]          @relation("DocumentUploadedBy")
  salesAudits                SalesAuditTrail[]          @relation("SalesAuditBy")
  announcements              MallAnnouncement[]         @relation("AnnouncementCreatedBy")
  createdBookings            UnitBooking[]              @relation("BookingCreatedBy")
  assignedBookings           UnitBooking[]              @relation("BookingAssignedTo")
  approvedBookingPrices      UnitBooking[]              @relation("BookingPriceApprover")
  bookingActivities          BookingActivity[]
  uploadedUnitMedia          UnitMedia[]
  unitHistoryChanges         UnitHistory[]              @relation("UnitHistoryChangedBy")
  slotBookings               SlotBooking[]              @relation("SlotBookedBy")
  categoryPricings           CategoryMallPricing[]      @relation("CategoryPricingCreatedBy")
  submittedSubmittals        FitoutSubmittal[]          @relation("SubmittalSubmittedBy")
  entityComments             EntityComment[]
  entityDistributions        EntityDistribution[]
  createdIssues              FitoutIssue[]              @relation("IssueCreatedBy")
  assignedIssues             FitoutIssue[]              @relation("IssueAssignedTo")
  createdDailyReports        FitoutDailyReportEntry[]   @relation("DailyReportCreatedBy")
  ownedFitoutRisks           FitoutRisk[]               @relation("FitoutRiskOwner")
  createdFitoutRisks         FitoutRisk[]               @relation("FitoutRiskCreatedBy")
  requestedFitoutChanges     FitoutChangeOrder[]        @relation("FitoutChangeRequestedBy")
  approvedFitoutChanges      FitoutChangeOrder[]        @relation("FitoutChangeApprovedBy")
  createdTickets             Ticket[]                   @relation("TicketCreatedBy")
  ticketComments             TicketComment[]
  voidedInvoices             Invoice[]                  @relation("InvoiceVoidedBy")
  reversedPayments           Payment[]                  @relation("PaymentReversedBy")
  maintenanceAssigned        MaintenanceSchedule[]      @relation("MaintenanceAssignedTo")
  maintenanceExecutions      MaintenanceExecution[]     @relation("MaintenancePerformedBy")
  inventoryTransactions      InventoryTransaction[]     @relation("InventoryTransactionCreatedBy")
  workOrdersRequested        WorkOrder[]                @relation("WorkOrderRequester")
  workOrdersAssigned         WorkOrder[]                @relation("WorkOrderAssignee")
  workOrdersReviewed         WorkOrder[]                @relation("WorkOrderReviewer")
  workOrderEvents            WorkOrderEvent[]
  workOrderChecklistDone     WorkOrderChecklistItem[]   @relation("WorkOrderChecklistCompletedBy")
  workOrderEvidence          WorkOrderEvidence[]
  workOrderComments          WorkOrderComment[]
  workOrderTemplatesCreated  WorkOrderTemplate[]        @relation("WorkOrderTemplateCreator")
  workOrderTemplatesAssigned WorkOrderTemplate[]        @relation("WorkOrderTemplateAssignee")
  patrolShiftsAssigned       PatrolShift[]              @relation("PatrolShiftAssignee")
  patrolShiftsCreated        PatrolShift[]              @relation("PatrolShiftCreator")
  patrolChecksPerformed      PatrolCheck[]              @relation("PatrolCheckPerformer")
  patrolSchedulesAssigned    PatrolSchedule[]           @relation("PatrolScheduleAssignee")
  patrolSchedulesCreated     PatrolSchedule[]           @relation("PatrolScheduleCreator")
  parkingShiftsCreated       ParkingShift[]             @relation("ParkingShiftCreator")
  parkingIncidentsReported   ParkingIncident[]          @relation("ParkingIncidentReporter")
  parkingContractsCreated    ParkingCustomerContract[]  @relation("ParkingContractCreator")
  parkingAdjustmentsCreated  ParkingVehicleAdjustment[] @relation("ParkingAdjustmentCreator")
  parkingPaymentsCreated     ParkingDebtPayment[]       @relation("ParkingPaymentCreator")
  parkingDocumentsUploaded   ParkingContractDocument[]  @relation("ParkingDocumentUploader")

  @@index([tenantId])
  @@index([inviteTokenHash])
}

model Mall {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  totalArea   Float?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buildings             Building[]
  floors                Floor[]
  zones                 Zone[]
  units                 Unit[]
  floorPlans            FloorPlanAnalysis[]
  occupancySnapshots    OccupancySnapshot[]
  mallPolicy            MallPolicy?
  userAccess            UserMallAccess[]
  announcements         MallAnnouncement[]
  maintenanceSchedules  MaintenanceSchedule[]
  unifiedDocuments      UnifiedDocument[]
  categoryPricings      CategoryMallPricing[]
  servicePriceCatalog   ServicePriceCatalog[]
  activeUsers           User[]                    @relation("UserActiveMall")
  leads                 Lead[]
  inventoryCategories   InventoryCategory[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  workOrders            WorkOrder[]
  workOrderTemplates    WorkOrderTemplate[]
  patrolRoutes          PatrolRoute[]
  patrolShifts          PatrolShift[]
  patrolSchedules       PatrolSchedule[]
  parkingZones          ParkingZone[]
  parkingShifts         ParkingShift[]
  parkingIncidents      ParkingIncident[]
  parkingContracts      ParkingCustomerContract[]
  billingParties        BillingParty[]
}

enum InventoryItemType {
  VTTH
  CCDC
  EQUIPMENT
}

enum InventoryTransactionType {
  IN
  OUT
  RETURN
  ADJUST
}

model InventoryCategory {
  id          String            @id @default(cuid())
  mallId      String
  mall        Mall              @relation(fields: [mallId], references: [id], onDelete: Cascade)
  code        String
  name        String
  itemType    InventoryItemType
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       InventoryItem[]

  @@unique([mallId, code])
  @@index([mallId, itemType, isActive])
}

model InventoryItem {
  id            String                 @id @default(cuid())
  mallId        String
  mall          Mall                   @relation(fields: [mallId], references: [id], onDelete: Cascade)
  categoryId    String
  category      InventoryCategory      @relation(fields: [categoryId], references: [id])
  sku           String
  name          String
  itemType      InventoryItemType
  unit          String
  specification String?
  manufacturer  String?
  location      String?
  minStock      Float                  @default(0)
  currentStock  Float                  @default(0)
  averageCost   Float                  @default(0)
  isActive      Boolean                @default(true)
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  transactions  InventoryTransaction[]

  @@unique([mallId, sku])
  @@index([mallId, itemType, isActive])
  @@index([categoryId])
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  transactionNo String                   @unique
  mallId        String
  mall          Mall                     @relation(fields: [mallId], references: [id], onDelete: Cascade)
  itemId        String
  item          InventoryItem            @relation(fields: [itemId], references: [id])
  type          InventoryTransactionType
  quantity      Float
  unitCost      Float?
  stockBefore   Float
  stockAfter    Float
  transactionAt DateTime                 @default(now())
  supplier      String?
  recipient     String?
  department    String?
  referenceNo   String?
  purpose       String?
  notes         String?
  createdById   String
  createdBy     User                     @relation("InventoryTransactionCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime                 @default(now())

  @@index([mallId, transactionAt])
  @@index([itemId, transactionAt])
  @@index([type])
}

model WorkOrder {
  id                 String                   @id @default(cuid())
  workOrderNumber    String                   @unique
  mallId             String
  mall               Mall                     @relation(fields: [mallId], references: [id], onDelete: Cascade)
  unitId             String?
  unit               Unit?                    @relation(fields: [unitId], references: [id])
  category           String
  title              String
  description        String?
  priority           String                   @default("MEDIUM")
  status             String                   @default("NEW")
  location           String?
  assignedDepartment String?
  requesterId        String
  requester          User                     @relation("WorkOrderRequester", fields: [requesterId], references: [id])
  assigneeId         String?
  assignee           User?                    @relation("WorkOrderAssignee", fields: [assigneeId], references: [id])
  reviewerId         String?
  reviewer           User?                    @relation("WorkOrderReviewer", fields: [reviewerId], references: [id])
  dueDate            DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  reviewedAt         DateTime?
  reviewStatus       String?
  reviewNote         String?
  sourceEntityType   String?
  sourceEntityId     String?
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  checklist          WorkOrderChecklistItem[]
  events             WorkOrderEvent[]
  evidence           WorkOrderEvidence[]
  comments           WorkOrderComment[]
  templateId         String?
  template           WorkOrderTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduledFor       DateTime?

  @@unique([templateId, scheduledFor])
  @@index([mallId, status, dueDate])
  @@index([assigneeId, status])
  @@index([assignedDepartment, status])
  @@index([sourceEntityType, sourceEntityId])
}

model WorkOrderTemplate {
  id                 String      @id @default(cuid())
  mallId             String
  mall               Mall        @relation(fields: [mallId], references: [id], onDelete: Cascade)
  name               String
  category           String
  title              String
  description        String?
  priority           String      @default("MEDIUM")
  location           String?
  assignedDepartment String?
  assigneeId         String?
  assignee           User?       @relation("WorkOrderTemplateAssignee", fields: [assigneeId], references: [id])
  frequency          String
  nextRunAt          DateTime
  lastRunAt          DateTime?
  dueHours           Int         @default(24)
  checklist          Json        @default("[]")
  isActive           Boolean     @default(true)
  createdById        String
  createdBy          User        @relation("WorkOrderTemplateCreator", fields: [createdById], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  workOrders         WorkOrder[]

  @@unique([mallId, name])
  @@index([isActive, nextRunAt])
  @@index([mallId, category])
}

model WorkOrderChecklistItem {
  id            String    @id @default(cuid())
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  isRequired    Boolean   @default(true)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("WorkOrderChecklistCompletedBy", fields: [completedById], references: [id])
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workOrderId, order])
}

model WorkOrderEvent {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  eventType   String
  description String?
  oldValue    String?
  newValue    String?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([workOrderId, createdAt])
}

model WorkOrderEvidence {
  id           String    @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  evidenceType String    @default("PROGRESS")
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  caption      String?
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([workOrderId, evidenceType])
}

model WorkOrderComment {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  content     String
  isInternal  Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([workOrderId, createdAt])
}

model PatrolRoute {
  id          String           @id @default(cuid())
  mallId      String
  mall        Mall             @relation(fields: [mallId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  points      PatrolPoint[]
  schedules   PatrolSchedule[]
  shifts      PatrolShift[]

  @@unique([mallId, code])
  @@index([mallId, isActive])
}

model PatrolPoint {
  id             String        @id @default(cuid())
  routeId        String
  route          PatrolRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  code           String
  name           String
  location       String?
  instructions   String?
  isRequired     Boolean       @default(true)
  requirePhoto   Boolean       @default(true)
  requireQrScan  Boolean       @default(false)
  qrToken        String        @unique @default(cuid())
  latitude       Float?
  longitude      Float?
  geofenceRadius Int?
  order          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  checks         PatrolCheck[]

  @@unique([routeId, code])
  @@index([routeId, order])
}

model PatrolSchedule {
  id                String        @id @default(cuid())
  mallId            String
  mall              Mall          @relation(fields: [mallId], references: [id], onDelete: Cascade)
  routeId           String
  route             PatrolRoute   @relation(fields: [routeId], references: [id])
  name              String
  assigneeId        String?
  assignee          User?         @relation("PatrolScheduleAssignee", fields: [assigneeId], references: [id])
  daysOfWeek        Int[]         @default([])
  timesOfDay        String[]      @default([])
  generateDaysAhead Int           @default(1)
  isActive          Boolean       @default(true)
  createdById       String
  createdBy         User          @relation("PatrolScheduleCreator", fields: [createdById], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  shifts            PatrolShift[]

  @@index([mallId, isActive])
}

model PatrolShift {
  id           String          @id @default(cuid())
  shiftNumber  String          @unique
  mallId       String
  mall         Mall            @relation(fields: [mallId], references: [id], onDelete: Cascade)
  routeId      String
  route        PatrolRoute     @relation(fields: [routeId], references: [id])
  scheduleId   String?
  schedule     PatrolSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  assigneeId   String?
  assignee     User?           @relation("PatrolShiftAssignee", fields: [assigneeId], references: [id])
  createdById  String
  createdBy    User            @relation("PatrolShiftCreator", fields: [createdById], references: [id])
  scheduledAt  DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  status       String          @default("SCHEDULED")
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  checks       PatrolCheck[]

  @@index([mallId, status, scheduledAt])
  @@index([assigneeId, status])
  @@index([scheduleId, scheduledAt])
}

model PatrolCheck {
  id               String      @id @default(cuid())
  shiftId          String
  shift            PatrolShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  pointId          String
  point            PatrolPoint @relation(fields: [pointId], references: [id])
  result           String      @default("PENDING")
  severity         String?
  note             String?
  checkedAt        DateTime?
  performedById    String?
  performedBy      User?       @relation("PatrolCheckPerformer", fields: [performedById], references: [id])
  qrVerified       Boolean     @default(false)
  latitude         Float?
  longitude        Float?
  distanceMeters   Float?
  locationVerified Boolean?
  tooFast          Boolean     @default(false)
  fileName         String?
  filePath         String?
  fileSize         Int?
  mimeType         String?
  workOrderId      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([shiftId, pointId])
  @@index([shiftId, result])
  @@index([workOrderId])
}

model ParkingCustomerContract {
  id              String                     @id @default(cuid())
  contractNumber  String                     @unique
  mallId          String
  mall            Mall                       @relation(fields: [mallId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant                     @relation(fields: [tenantId], references: [id])
  title           String
  status          String                     @default("DRAFT")
  signedDate      DateTime?
  startDate       DateTime
  endDate         DateTime
  billingDay      Int                        @default(1)
  paymentTermDays Int                        @default(15)
  depositAmount   Float                      @default(0)
  currency        String                     @default("VND")
  notes           String?
  isActive        Boolean                    @default(true)
  createdById     String
  createdBy       User                       @relation("ParkingContractCreator", fields: [createdById], references: [id])
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  rates           ParkingContractRate[]
  adjustments     ParkingVehicleAdjustment[]
  statements      ParkingMonthlyStatement[]
  documents       ParkingContractDocument[]

  @@index([mallId, status, endDate])
  @@index([tenantId, status])
}

model ParkingContractRate {
  id                 String                  @id @default(cuid())
  contractId         String
  contract           ParkingCustomerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  vehicleType        String
  registeredQuantity Int
  unitPrice          Float
  excessUnitPrice    Float
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([contractId, vehicleType, effectiveFrom])
}

model ParkingVehicleAdjustment {
  id               String                  @id @default(cuid())
  contractId       String
  contract         ParkingCustomerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  vehicleType      String
  previousQuantity Int
  newQuantity      Int
  effectiveDate    DateTime
  reason           String
  createdById      String
  createdBy        User                    @relation("ParkingAdjustmentCreator", fields: [createdById], references: [id])
  createdAt        DateTime                @default(now())

  @@index([contractId, effectiveDate])
}

model ParkingMonthlyStatement {
  id                   String                  @id @default(cuid())
  contractId           String
  contract             ParkingCustomerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  period               String
  periodStart          DateTime
  periodEnd            DateTime
  issueDate            DateTime                @default(now())
  dueDate              DateTime
  subtotal             Float
  adjustment           Float                   @default(0)
  totalAmount          Float
  paidAmount           Float                   @default(0)
  status               String                  @default("UNPAID")
  reconciliationStatus String                  @default("PENDING")
  notes                String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  lines                ParkingMonthlyLine[]
  payments             ParkingDebtPayment[]

  @@unique([contractId, period])
  @@index([status, dueDate])
  @@index([period])
}

model ParkingMonthlyLine {
  id                 String                  @id @default(cuid())
  statementId        String
  statement          ParkingMonthlyStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  vehicleType        String
  registeredQuantity Int
  actualQuantity     Int
  excessQuantity     Int
  unitPrice          Float
  excessUnitPrice    Float
  baseAmount         Float
  excessAmount       Float
  totalAmount        Float
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([statementId, vehicleType])
}

model ParkingDebtPayment {
  id          String                  @id @default(cuid())
  statementId String
  statement   ParkingMonthlyStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  amount      Float
  paidAt      DateTime
  method      String?
  referenceNo String?
  notes       String?
  createdById String
  createdBy   User                    @relation("ParkingPaymentCreator", fields: [createdById], references: [id])
  createdAt   DateTime                @default(now())

  @@index([statementId, paidAt])
}

model ParkingContractDocument {
  id           String                  @id @default(cuid())
  contractId   String
  contract     ParkingCustomerContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  documentType String                  @default("CONTRACT")
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  uploadedById String
  uploadedBy   User                    @relation("ParkingDocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime                @default(now())

  @@index([contractId, documentType])
}

model ParkingZone {
  id              String            @id @default(cuid())
  mallId          String
  mall            Mall              @relation(fields: [mallId], references: [id], onDelete: Cascade)
  code            String
  name            String
  location        String?
  carCapacity     Int               @default(0)
  motorCapacity   Int               @default(0)
  bicycleCapacity Int               @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  shifts          ParkingShift[]
  incidents       ParkingIncident[]

  @@unique([mallId, code])
  @@index([mallId, isActive])
}

model ParkingShift {
  id             String            @id @default(cuid())
  shiftNumber    String            @unique
  mallId         String
  mall           Mall              @relation(fields: [mallId], references: [id], onDelete: Cascade)
  zoneId         String
  zone           ParkingZone       @relation(fields: [zoneId], references: [id])
  shiftDate      DateTime
  shiftName      String
  status         String            @default("OPEN")
  openingCars    Int               @default(0)
  openingMotors  Int               @default(0)
  carIn          Int               @default(0)
  carOut         Int               @default(0)
  motorIn        Int               @default(0)
  motorOut       Int               @default(0)
  bicycleIn      Int               @default(0)
  bicycleOut     Int               @default(0)
  peakCars       Int               @default(0)
  peakMotors     Int               @default(0)
  cashRevenue    Float             @default(0)
  nonCashRevenue Float             @default(0)
  notes          String?
  closedAt       DateTime?
  createdById    String
  createdBy      User              @relation("ParkingShiftCreator", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  incidents      ParkingIncident[]

  @@unique([zoneId, shiftDate, shiftName])
  @@index([mallId, shiftDate, status])
}

model ParkingIncident {
  id           String        @id @default(cuid())
  incidentNo   String        @unique
  mallId       String
  mall         Mall          @relation(fields: [mallId], references: [id], onDelete: Cascade)
  zoneId       String
  zone         ParkingZone   @relation(fields: [zoneId], references: [id])
  shiftId      String?
  shift        ParkingShift? @relation(fields: [shiftId], references: [id])
  type         String
  severity     String        @default("MEDIUM")
  title        String
  description  String?
  status       String        @default("OPEN")
  occurredAt   DateTime      @default(now())
  resolvedAt   DateTime?
  workOrderId  String?
  reportedById String
  reportedBy   User          @relation("ParkingIncidentReporter", fields: [reportedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([mallId, status, occurredAt])
  @@index([zoneId, occurredAt])
  @@index([workOrderId])
}

model Building {
  id        String   @id @default(cuid())
  mallId    String
  mall      Mall     @relation(fields: [mallId], references: [id])
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floors Floor[]
  zones  Zone[]
  units  Unit[]
}

model Floor {
  id         String    @id @default(cuid())
  mallId     String
  mall       Mall      @relation(fields: [mallId], references: [id])
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id])
  name       String
  level      String
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Digital Map -- floor plan image for interactive map
  floorPlanUrl   String? // URL/path of uploaded floor plan image
  floorPlanRatio Float? // aspect ratio (width/height) stored for correct rendering

  zones            Zone[]
  units            Unit[]
  categoryPricings CategoryMallPricing[]
}

model Zone {
  id         String    @id @default(cuid())
  mallId     String
  mall       Mall      @relation(fields: [mallId], references: [id])
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id])
  floorId    String?
  floor      Floor?    @relation(fields: [floorId], references: [id])
  name       String
  code       String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  units            Unit[]
  categoryPricings CategoryMallPricing[]
}

model Unit {
  id             String     @id @default(cuid())
  mallId         String
  mall           Mall       @relation(fields: [mallId], references: [id])
  buildingId     String?
  building       Building?  @relation(fields: [buildingId], references: [id])
  floorId        String?
  floor          Floor?     @relation(fields: [floorId], references: [id])
  zoneId         String?
  zone           Zone?      @relation(fields: [zoneId], references: [id])
  code           String
  name           String?
  areaGFA        Float
  areaNLA        Float      @default(0)
  category       String? // Legacy: free text category
  categoryId     String? // NEW: FK to Category master
  categoryRef    Category?  @relation(fields: [categoryId], references: [id])
  baseRentPerSqm Float      @default(0)
  camPerSqm      Float      @default(0)
  status         UnitStatus @default(VACANT)
  tenantId       String?
  tenant         Tenant?    @relation("OccupiedUnit", fields: [tenantId], references: [id])
  leaseStartDate DateTime?
  leaseEndDate   DateTime?
  description    String?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Phase 1 & 2: New pricing fields
  marketRentPerSqm Float? // Market reference rent
  askingRentPerSqm Float? // Asking rent (negotiable)
  escalationRate   Float? // Annual escalation rate (%)
  minLeaseTerm     Int? // Minimum lease term (months)
  maxLeaseTerm     Int? // Maximum lease term (months)

  // Phase 1: Tracking fields
  vacantSince    DateTime? // When unit became vacant
  lastRenovation DateTime? // Last renovation date
  condition      String? // EXCELLENT, GOOD, FAIR, NEEDS_RENOVATION

  // Phase 2: Additional info
  features       Json? // {ac: true, water: true, electricity: true, facing: 'N', corner: false}
  virtualTourUrl String? // 360deg tour / video link

  // GAP #3 -- Phn loi hnh thc thu
  leaseTermType UnitLeaseTermType? // LONG hoc SHORT; LONG c th cho thu ngn hn khi trng

  // GAP #4 -- Loi mt bng
  spaceType SpaceType? // RETAIL_UNIT, LED, ESCALATOR_WRAP...

  // GAP #5 -- Snh linh ng
  isFlexibleArea Boolean @default(false) // true = thu theo m2 khng c nh
  minFlexArea    Float? // Din tch ti thiu c th book (m2)
  maxFlexArea    Float? // Din tch ti a c th book (m2)

  // GAP #6 -- Tier A/B/C
  tier UnitTier? // A = prime, B = standard, C = value

  // GAP #2 -- Gp snh
  isCombined    Boolean @default(false) // true nu l unit tng hp t nhiu unit khc
  mergedFromIds Json? // [unitId, unitId, ...] -- cc unit ngun
  mergedIntoId  String? // ID ca combined unit m unit ny  b gp vo

  // Digital Map -- position on floor plan (% of image dimensions, 0-100)
  mapPosX    Float? // left edge % (legacy rect mode)
  mapPosY    Float? // top edge %
  mapPosW    Float? // width %
  mapPosH    Float? // height %
  mapPolygon Json? // [[x%, y%], ...] polygon vertices

  proposals            Proposal[]
  contracts            Contract[]
  fitoutProjects       FitoutProject[]
  tickets              Ticket[]
  salesTurnovers       SalesTurnover[]
  maintenanceSchedules MaintenanceSchedule[]
  bookings             UnitBooking[]
  media                UnitMedia[]
  history              UnitHistory[]
  slots                UnitSlot[]
  fitoutIssues         FitoutIssue[]
  workOrders           WorkOrder[]

  @@unique([mallId, code])
  @@index([mallId, status])
  @@index([floorId, status])
  @@index([status, areaNLA])
  @@index([leaseEndDate])
  @@index([status, updatedAt])
  @@index([category, status, mallId])
  @@index([vacantSince])
}

model Tenant {
  id           String    @id @default(cuid())
  companyName  String
  brandName    String
  taxCode      String?   @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  category     String? // Legacy: free text
  categoryId   String? // NEW: FK to Category master
  categoryRef  Category? @relation(fields: [categoryId], references: [id])
  logo         String?
  isPortalUser Boolean   @default(false)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  occupiedUnits    Unit[]                    @relation("OccupiedUnit")
  leads            Lead[]
  proposals        Proposal[]
  contracts        Contract[]
  fitoutProjects   FitoutProject[]
  tickets          Ticket[]
  salesTurnovers   SalesTurnover[]
  invoices         Invoice[]
  payments         Payment[]
  notifications    Notification[]
  customers        Customer[]
  portalUsers      User[]
  parkingContracts ParkingCustomerContract[]
  billingParty     BillingParty?
}

model Lead {
  id                String       @id @default(cuid())
  brandName         String
  company           String?
  contactName       String
  phone             String?
  email             String?
  category          String? // Legacy: free text
  categoryId        String? // NEW: FK to Category master
  categoryRef       Category?    @relation(fields: [categoryId], references: [id])
  source            LeadSource   @default(WALK_IN)
  status            LeadStatus   @default(NEW)
  priority          LeadPriority @default(WARM)
  assignedToId      String?
  assignedTo        User?        @relation("AssignedLeads", fields: [assignedToId], references: [id])
  tenantId          String?
  tenant            Tenant?      @relation(fields: [tenantId], references: [id])
  customerId        String?
  customer          Customer?    @relation(fields: [customerId], references: [id])
  mallId            String?
  mall              Mall?        @relation(fields: [mallId], references: [id])
  notes             String?
  expectedRent      Float?
  expectedArea      Float?
  estimatedValue    Float?
  expectedCloseDate DateTime?
  preferredCategory String?
  position          Int          @default(0)
  lastActivityAt    DateTime?
  lostReason        String?
  isActive          Boolean      @default(true)
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  activities   LeadActivity[]
  proposals    Proposal[]
  followUps    LeadFollowUp[]
  bookings     UnitBooking[]
  slotBookings SlotBooking[]

  @@index([status, priority, position])
  @@index([mallId])
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])
  type        String
  note        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Proposal {
  id                  String         @id @default(cuid())
  proposalNumber      String         @unique
  leadId              String?
  lead                Lead?          @relation(fields: [leadId], references: [id])
  tenantId            String?
  tenant              Tenant?        @relation(fields: [tenantId], references: [id])
  unitId              String
  unit                Unit           @relation(fields: [unitId], references: [id])
  area                Float
  term                Int
  startDate           DateTime
  endDate             DateTime?
  rentPerSqm          Float
  camPerSqm           Float          @default(0)
  deposit             Float          @default(3)
  rentFree            Int            @default(0)
  escalationPercent   Float          @default(0)
  revenueSharePercent Float          @default(0)
  marketingFee        Float          @default(0)
  monthlyRent         Float
  monthlyCAM          Float
  depositAmount       Float
  totalContractValue  Float
  discount            Float          @default(0)
  status              ProposalStatus @default(DRAFT)
  notes               String?
  pricingRuleId       String? // Rule version used when pricing was evaluated
  pricingSnapshot     Json?   // Immutable effective values + source metadata

  // T Trnh fields
  businessModel         BusinessModelEnum? // GAP #8: enum SHOP/KIOSK/POP_UP/EVENT/CHAIN
  serviceFeeSqm         Float              @default(0) // Ph Dch v (USD/m2/thng)
  businessSupportFeeSqm Float              @default(0) // Ph h tr Kinh doanh
  rentCurrency          String             @default("VND") // VND hoc USD
  fitoutDays            Int                @default(90) // Thi hn hon thin ni tht (ngy)
  handoverDate          DateTime? // Ngy Bn giao Mt bng
  openingDate           DateTime? // Ngy Khai trng d kin
  specialConditions     String? // iu kin c bit (mc 21)
  editorContent         Json? // Editor state: logo, font, color, item overrides, signatories

  // GAP #42 -- T gi
  exchangeRate       Float? // VND/USD t gi ti thi im lp T Trnh
  exchangeRateSource String? // Ngun t gi (VCB, ...)

  // GAP #7 -- Din tch trn HT vs thc t
  contractedArea Float? // Din tch cht trn T Trnh (m2)
  actualArea     Float? // Din tch thc t sau o c bn giao (m2)

  // GAP #91-94 -- 4 field cn thiu trong 21 mc T Trnh XN
  utilityFee      Float   @default(0) // Ph tin ch (mc 12 -- VND/thng)
  operatingHours  String? // Gi hot ng (mc 13 -- vd: "10:00-22:00")
  afterHoursFee   Float   @default(0) // Ph ngoi gi (mc 14 -- VND/gi)
  paymentTermDays Int     @default(30) // iu khon thanh ton (mc 16 -- s ngy)

  // GAP #41 -- Tch 3 khon cc
  depositLease  Float? // Tin cc thu (VND) -- null = tnh t deposit x monthlyRent
  depositFitout Float  @default(0) // Cc thi cng (VND)
  fitoutFee     Float  @default(0) // Ph thi cng (VND)

  createdById String
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookingId        String?            @unique
  booking          UnitBooking?       @relation(fields: [bookingId], references: [id])
  approvalWorkflow ApprovalWorkflow?
  contract         Contract?
  versions         ProposalVersion[]
  dealScore        ProposalDealScore?
  scenarios        ProposalScenario[]
  services         ProposalService[] // GAP #15 -- line items dch v
}

model ProposalVersion {
  id           String   @id @default(cuid())
  proposalId   String
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  changeReason String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@unique([proposalId, version])
  @@index([proposalId])
}

// --- GAP #15 -- Service Price Catalog ------------------------------------------

model ServicePriceCatalog {
