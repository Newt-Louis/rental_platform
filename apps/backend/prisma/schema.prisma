generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEASING_EXECUTIVE
  LEASING_MANAGER
  MALL_DIRECTOR
  FINANCE
  LEGAL
  OPERATION
  TENANT
  CEO
}

enum UnitStatus {
  VACANT       // Trống
  BOOKING      // Đang booking/giữ chỗ
  NEGOTIATING  // Đang thương thảo (proposal stage)
  CONTRACTED   // Đã ký hợp đồng, chờ thi công
  UNDER_FITOUT // Đang thi công
  OCCUPIED     // Đang thuê
  MERGED       // Đã gộp vào sảnh khác (ẩn khỏi danh sách thường)
}

enum UnitLeaseTermType {
  LONG   // Dài hạn (3-5 năm)
  SHORT  // Ngắn hạn (ngày/tuần/tháng)
}

enum SpaceType {
  RETAIL_UNIT    // Sảnh bán lẻ thông thường
  LED            // Bảng LED/màn hình quảng cáo
  ESCALATOR_WRAP // Thang cuốn
  KIOSK_EVENT    // Kiosk / sự kiện
  ADVERTISING    // Vị trí quảng cáo
  SERVICE        // Dịch vụ (ngân hàng, bưu điện...)
}

enum UnitTier {
  A // Prime — giá cao nhất
  B // Standard
  C // Value
}

enum BusinessModelEnum {
  SHOP
  KIOSK
  POP_UP
  EVENT
  CHAIN
}

enum BookingStatus {
  PENDING     // Mới tạo, chờ sale xác nhận
  ACTIVE      // Đang giữ slot (unit → BOOKING)
  EXPIRED     // Quá hạn hold
  CANCELLED   // Hủy thủ công
  CONVERTED   // Đã chuyển thành Proposal
}

enum UnitMediaType {
  PHOTO
  FLOOR_PLAN
  VIDEO
  RENDER_3D
  BROCHURE
  SITE_MAP
}

enum BookingActivityType {
  CREATED
  ACTIVATED
  PRIORITY_CHANGED
  EXTENDED
  NOTE_ADDED
  CONVERTED
  CANCELLED
  EXPIRED
}

enum LeadSource {
  BROKER
  WEBSITE
  REFERRAL
  WALK_IN
  EXISTING_TENANT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  HOT
  WARM
  COLD
}

enum CustomerStatus {
  PROSPECT
  NEGOTIATING
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  SITE_VISIT
  PROPOSAL_SENT
  NOTE
  OTHER
}

enum PriceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ═══════════════════════════════════════════════════════════════════════════
// CATEGORY MASTER DATA
// ═══════════════════════════════════════════════════════════════════════════

model Category {
  id          String      @id @default(cuid())
  code        String      @unique    // "FNB", "FASHION", "BEAUTY"
  name        String                 // "F&B", "Fashion", "Beauty & Wellness"
  description String?
  parentId    String?                // For sub-categories
  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  units             Unit[]
  tenants           Tenant[]
  leads             Lead[]
  customers         Customer[]
  categoryPricings  CategoryMallPricing[]

  @@index([code])
  @@index([parentId])
  @@index([isActive, sortOrder])
}

model CategoryMallPricing {
  id              String    @id @default(cuid())
  mallId          String
  mall            Mall      @relation(fields: [mallId], references: [id])
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  floorId         String?
  floor           Floor?    @relation(fields: [floorId], references: [id])
  zoneId          String?
  zone            Zone?     @relation(fields: [zoneId], references: [id])
  
  // Price range (VND/m²/month)
  minRentPerSqm   Float                 // Giá sàn
  maxRentPerSqm   Float                 // Giá trần
  suggestedRent   Float?                // Giá đề xuất (tham khảo)
  
  // CAM pricing
  camPerSqm       Float     @default(0) // Phí quản lý chuẩn
  
  effectiveFrom   DateTime  @default(now())
  effectiveTo     DateTime?             // Null = vô thời hạn
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  createdBy       User?     @relation("CategoryPricingCreatedBy", fields: [createdById], references: [id])

  @@unique([mallId, categoryId, floorId, zoneId, effectiveFrom])
  @@index([mallId, categoryId, isActive])
  @@index([effectiveFrom, effectiveTo])
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum StepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ContractType {
  LOI
  LEASE_AGREEMENT
  APPENDIX
  RENEWAL
  TERMINATION
}

enum ContractStatus {
  DRAFT
  PENDING_LEGAL
  PENDING_SIGNATURE
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATING
  TERMINATED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum AmendmentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  APPLIED
}

enum AmendmentType {
  RENT_CHANGE
  TERM_EXTENSION
  RENT_FREE_CHANGE
  CAM_CHANGE
  RENEWAL
  OTHER
}

enum TicketType {
  ELECTRICAL
  WATER
  HVAC
  CLEANING
  SECURITY
  PARKING
  INTERNET
  DELIVERY
  MARKETING_EVENT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_TENANT
  RESOLVED
  CLOSED
}

// Ai khởi tạo ticket — tenant tự gửi yêu cầu, hay nhân viên tạo phiếu kiểm tra hiện trường gửi cho tenant.
enum TicketSource {
  TENANT_REQUEST
  STAFF_INSPECTION
}

enum InvoiceType {
  MONTHLY_RENT
  DEPOSIT
  UTILITY
  MARKETING_FEE
  PARKING
  PENALTY
  REVENUE_SHARE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  ONLINE
}

enum SapStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  fullName      String
  role          Role      @default(LEASING_EXECUTIVE)
  phone         String?
  avatar        String?
  department    String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Liên kết tài khoản đăng nhập (role=TENANT) với Tenant record tương ứng — chỉ có ý nghĩa với role TENANT.
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])

  assignedLeads        Lead[]             @relation("AssignedLeads")
  approvalSteps        ApprovalStep[]
  ticketsAssigned      Ticket[]           @relation("AssignedTickets")
  auditLogs            AuditLog[]
  notifications        Notification[]
  managedContracts     Contract[]         @relation("ManagedContracts")
  fitoutProjects       FitoutProject[]    @relation("OperationManaged")
  recordedSales        SalesTurnover[]    @relation("RecordedBy")
  leadActivities       LeadActivity[]
  assignedCustomers    Customer[]         @relation("AssignedCustomers")
  createdCustomers     Customer[]         @relation("CreatedCustomers")
  customerActivities   CustomerActivity[] @relation("CustomerActivityBy")
  contractEvents       ContractEvent[]
  mallAccess           UserMallAccess[]
  followUpsAssigned    LeadFollowUp[]     @relation("FollowUpAssigned")
  uploadedDocuments    UnifiedDocument[]  @relation("DocumentUploadedBy")
  salesAudits          SalesAuditTrail[]  @relation("SalesAuditBy")
  announcements        MallAnnouncement[] @relation("AnnouncementCreatedBy")
  createdBookings      UnitBooking[]      @relation("BookingCreatedBy")
  assignedBookings     UnitBooking[]      @relation("BookingAssignedTo")
  approvedBookingPrices UnitBooking[]     @relation("BookingPriceApprover")
  bookingActivities    BookingActivity[]
  uploadedUnitMedia    UnitMedia[]
  unitHistoryChanges   UnitHistory[]      @relation("UnitHistoryChangedBy")
  slotBookings         SlotBooking[]      @relation("SlotBookedBy")
  categoryPricings     CategoryMallPricing[] @relation("CategoryPricingCreatedBy")
  submittedSubmittals  FitoutSubmittal[]  @relation("SubmittalSubmittedBy")
  entityComments       EntityComment[]
  entityDistributions  EntityDistribution[]
  createdIssues        FitoutIssue[]      @relation("IssueCreatedBy")
  assignedIssues       FitoutIssue[]      @relation("IssueAssignedTo")
  createdDailyReports  FitoutDailyReportEntry[] @relation("DailyReportCreatedBy")
  createdTickets       Ticket[]           @relation("TicketCreatedBy")
  ticketComments       TicketComment[]
  voidedInvoices       Invoice[]          @relation("InvoiceVoidedBy")
  reversedPayments     Payment[]          @relation("PaymentReversedBy")

  @@index([tenantId])
}

model Mall {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  address     String?
  city        String?
  totalArea   Float?
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  buildings            Building[]
  floors               Floor[]
  zones                Zone[]
  units                Unit[]
  floorPlans           FloorPlanAnalysis[]
  occupancySnapshots   OccupancySnapshot[]
  mallPolicy           MallPolicy?
  userAccess           UserMallAccess[]
  announcements        MallAnnouncement[]
  maintenanceSchedules MaintenanceSchedule[]
  unifiedDocuments     UnifiedDocument[]
  categoryPricings     CategoryMallPricing[]
  servicePriceCatalog  ServicePriceCatalog[]
}

model Building {
  id        String    @id @default(cuid())
  mallId    String
  mall      Mall      @relation(fields: [mallId], references: [id])
  name      String
  code      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  floors    Floor[]
  zones     Zone[]
  units     Unit[]
}

model Floor {
  id             String    @id @default(cuid())
  mallId         String
  mall           Mall      @relation(fields: [mallId], references: [id])
  buildingId     String?
  building       Building? @relation(fields: [buildingId], references: [id])
  name           String
  level          String
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Digital Map — floor plan image for interactive map
  floorPlanUrl   String?   // URL/path of uploaded floor plan image
  floorPlanRatio Float?    // aspect ratio (width/height) stored for correct rendering

  zones             Zone[]
  units             Unit[]
  categoryPricings  CategoryMallPricing[]
}

model Zone {
  id         String    @id @default(cuid())
  mallId     String
  mall       Mall      @relation(fields: [mallId], references: [id])
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id])
  floorId    String?
  floor      Floor?    @relation(fields: [floorId], references: [id])
  name       String
  code       String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  units             Unit[]
  categoryPricings  CategoryMallPricing[]
}

model Unit {
  id              String     @id @default(cuid())
  mallId          String
  mall            Mall       @relation(fields: [mallId], references: [id])
  buildingId      String?
  building        Building?  @relation(fields: [buildingId], references: [id])
  floorId         String?
  floor           Floor?     @relation(fields: [floorId], references: [id])
  zoneId          String?
  zone            Zone?      @relation(fields: [zoneId], references: [id])
  code            String
  name            String?
  areaGFA         Float
  areaNLA         Float
  category        String?      // Legacy: free text category
  categoryId      String?      // NEW: FK to Category master
  categoryRef     Category?    @relation(fields: [categoryId], references: [id])
  baseRentPerSqm  Float      @default(0)
  camPerSqm       Float      @default(0)
  status          UnitStatus @default(VACANT)
  tenantId        String?
  tenant          Tenant?    @relation("OccupiedUnit", fields: [tenantId], references: [id])
  leaseStartDate  DateTime?
  leaseEndDate    DateTime?
  description     String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Phase 1 & 2: New pricing fields
  marketRentPerSqm  Float?        // Market reference rent
  askingRentPerSqm  Float?        // Asking rent (negotiable)
  escalationRate    Float?        // Annual escalation rate (%)
  minLeaseTerm      Int?          // Minimum lease term (months)
  maxLeaseTerm      Int?          // Maximum lease term (months)

  // Phase 1: Tracking fields
  vacantSince       DateTime?     // When unit became vacant
  lastRenovation    DateTime?     // Last renovation date
  condition         String?       // EXCELLENT, GOOD, FAIR, NEEDS_RENOVATION

  // Phase 2: Additional info
  features          Json?         // {ac: true, water: true, electricity: true, facing: 'N', corner: false}
  virtualTourUrl    String?       // 360° tour / video link

  // GAP #3 — Phân loại hình thức thuê
  leaseTermType     UnitLeaseTermType?  // LONG hoặc SHORT; LONG có thể cho thuê ngắn hạn khi trống

  // GAP #4 — Loại mặt bằng
  spaceType         SpaceType?          // RETAIL_UNIT, LED, ESCALATOR_WRAP...

  // GAP #5 — Sảnh linh động
  isFlexibleArea    Boolean     @default(false) // true = thuê theo m² không cố định
  minFlexArea       Float?                       // Diện tích tối thiểu có thể book (m²)
  maxFlexArea       Float?                       // Diện tích tối đa có thể book (m²)

  // GAP #6 — Tier A/B/C
  tier              UnitTier?           // A = prime, B = standard, C = value

  // GAP #2 — Gộp sảnh
  isCombined        Boolean     @default(false) // true nếu là unit tổng hợp từ nhiều unit khác
  mergedFromIds     Json?                        // [unitId, unitId, ...] — các unit nguồn
  mergedIntoId      String?                      // ID của combined unit mà unit này đã bị gộp vào

  // Digital Map — position on floor plan (% of image dimensions, 0-100)
  mapPosX           Float?        // left edge % (legacy rect mode)
  mapPosY           Float?        // top edge %
  mapPosW           Float?        // width %
  mapPosH           Float?        // height %
  mapPolygon        Json?         // [[x%, y%], ...] polygon vertices

  proposals            Proposal[]
  contracts            Contract[]
  fitoutProjects       FitoutProject[]
  tickets              Ticket[]
  salesTurnovers       SalesTurnover[]
  maintenanceSchedules MaintenanceSchedule[]
  bookings             UnitBooking[]
  media                UnitMedia[]
  history              UnitHistory[]
  slots                UnitSlot[]
  fitoutIssues         FitoutIssue[]

  @@unique([mallId, code])
  @@index([mallId, status])
  @@index([floorId, status])
  @@index([status, areaNLA])
  @@index([leaseEndDate])
  @@index([status, updatedAt])
  @@index([category, status, mallId])
  @@index([vacantSince])
}

model Tenant {
  id             String    @id @default(cuid())
  companyName    String
  brandName      String
  taxCode        String?   @unique
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  category       String?      // Legacy: free text
  categoryId     String?      // NEW: FK to Category master
  categoryRef    Category?    @relation(fields: [categoryId], references: [id])
  logo           String?
  isPortalUser   Boolean   @default(false)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  occupiedUnits  Unit[]          @relation("OccupiedUnit")
  leads          Lead[]
  proposals      Proposal[]
  contracts      Contract[]
  fitoutProjects FitoutProject[]
  tickets        Ticket[]
  salesTurnovers SalesTurnover[]
  invoices       Invoice[]
  payments       Payment[]
  notifications  Notification[]
  customers      Customer[]
  portalUsers    User[]
}

model Lead {
  id           String       @id @default(cuid())
  brandName    String
  company      String?
  contactName  String
  phone        String?
  email        String?
  category     String?      // Legacy: free text
  categoryId   String?      // NEW: FK to Category master
  categoryRef  Category?    @relation(fields: [categoryId], references: [id])
  source       LeadSource   @default(WALK_IN)
  status       LeadStatus   @default(NEW)
  priority     LeadPriority @default(WARM)
  assignedToId String?
  assignedTo   User?        @relation("AssignedLeads", fields: [assignedToId], references: [id])
  tenantId     String?
  tenant       Tenant?      @relation(fields: [tenantId], references: [id])
  customerId   String?
  customer     Customer?    @relation(fields: [customerId], references: [id])
  notes        String?
  expectedRent Float?
  expectedArea Float?
  estimatedValue    Float?
  expectedCloseDate DateTime?
  preferredCategory String?
  position          Int        @default(0)
  lastActivityAt    DateTime?
  lostReason        String?
  isActive     Boolean    @default(true)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  activities   LeadActivity[]
  proposals    Proposal[]
  followUps    LeadFollowUp[]
  bookings     UnitBooking[]
  slotBookings SlotBooking[]

  @@index([status, priority, position])
}

model LeadActivity {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id])
  type        String
  note        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model Proposal {
  id                   String         @id @default(cuid())
  proposalNumber       String         @unique
  leadId               String?
  lead                 Lead?          @relation(fields: [leadId], references: [id])
  tenantId             String?
  tenant               Tenant?        @relation(fields: [tenantId], references: [id])
  unitId               String
  unit                 Unit           @relation(fields: [unitId], references: [id])
  area                 Float
  term                 Int
  startDate            DateTime
  endDate              DateTime?
  rentPerSqm           Float
  camPerSqm            Float          @default(0)
  deposit              Float          @default(3)
  rentFree             Int            @default(0)
  escalationPercent    Float          @default(0)
  revenueSharePercent  Float          @default(0)
  marketingFee         Float          @default(0)
  monthlyRent          Float
  monthlyCAM           Float
  depositAmount        Float
  totalContractValue   Float
  discount             Float          @default(0)
  status               ProposalStatus @default(DRAFT)
  notes                String?

  // Tờ Trình fields
  businessModel        BusinessModelEnum?  // GAP #8: enum SHOP/KIOSK/POP_UP/EVENT/CHAIN
  serviceFeeSqm        Float          @default(0)   // Phí Dịch vụ (USD/m²/tháng)
  businessSupportFeeSqm Float         @default(0)   // Phí hỗ trợ Kinh doanh
  rentCurrency         String         @default("VND") // VND hoặc USD
  fitoutDays           Int            @default(90)  // Thời hạn hoàn thiện nội thất (ngày)
  handoverDate         DateTime?      // Ngày Bàn giao Mặt bằng
  openingDate          DateTime?      // Ngày Khai trương dự kiến
  specialConditions    String?        // Điều kiện đặc biệt (mục 21)
  editorContent        Json?          // Editor state: logo, font, color, item overrides, signatories

  // GAP #42 — Tỷ giá
  exchangeRate         Float?         // VND/USD tỷ giá tại thời điểm lập Tờ Trình
  exchangeRateSource   String?        // Nguồn tỷ giá (VCB, ...)

  // GAP #7 — Diện tích trên HĐT vs thực tế
  contractedArea       Float?         // Diện tích chốt trên Tờ Trình (m²)
  actualArea           Float?         // Diện tích thực tế sau đo đạc bàn giao (m²)

  createdById          String
  isActive             Boolean        @default(true)
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  bookingId            String?        @unique
  booking              UnitBooking?   @relation(fields: [bookingId], references: [id])
  approvalWorkflow     ApprovalWorkflow?
  contract             Contract?
  versions             ProposalVersion[]
  dealScore            ProposalDealScore?
  scenarios            ProposalScenario[]
  services             ProposalService[]  // GAP #15 — line items dịch vụ
}

model ProposalVersion {
  id           String   @id @default(cuid())
  proposalId   String
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  version      Int
  snapshot     Json
  changeReason String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@unique([proposalId, version])
  @@index([proposalId])
}

// ─── GAP #15 — Service Price Catalog ──────────────────────────────────────────

model ServicePriceCatalog {
  id           String   @id @default(cuid())
  mallId       String
  mall         Mall     @relation(fields: [mallId], references: [id])
  serviceCode  String
  name         String   // Tên dịch vụ: "LED screen", "Escalator wrap", "MKT support"...
  unit         String   // Đơn vị tính: "m²", "tháng", "kỳ", "lần"
  defaultPrice Float    // Giá mặc định
  currency     String   @default("VND")
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  proposalServices ProposalService[]

  @@unique([mallId, serviceCode])
  @@index([mallId, isActive])
}

model ProposalService {
  id               String               @id @default(cuid())
  proposalId       String
  proposal         Proposal             @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  serviceCatalogId String?
  serviceCatalog   ServicePriceCatalog? @relation(fields: [serviceCatalogId], references: [id])
  serviceCode      String
  name             String
  quantity         Float                @default(1)
  unit             String
  unitPrice        Float
  totalPrice       Float
  currency         String               @default("VND")
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([proposalId])
}

model ApprovalWorkflow {
  id          String         @id @default(cuid())
  entityType  String
  entityId    String
  proposalId  String?        @unique
  proposal    Proposal?      @relation(fields: [proposalId], references: [id])
  status      WorkflowStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  steps       ApprovalStep[]
  fitoutSubmittal FitoutSubmittal?
}

model ApprovalStep {
  id           String     @id @default(cuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  stepOrder    Int
  stepName     String
  approverRole Role
  approverId   String?
  approver     User?      @relation(fields: [approverId], references: [id])
  status       StepStatus @default(PENDING)
  comment      String?
  decidedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model ApprovalPolicyRule {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  stepName      String
  stepOrder     Int
  approverRole  Role
  conditionType String
  operator      String?
  threshold     Float?
  matchValue    String?
  isRequired    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, stepOrder])
}

model Contract {
  id                String         @id @default(cuid())
  contractNumber    String         @unique
  proposalId        String?        @unique
  proposal          Proposal?      @relation(fields: [proposalId], references: [id])
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  unitId            String
  unit              Unit           @relation(fields: [unitId], references: [id])
  type              ContractType   @default(LEASE_AGREEMENT)
  status            ContractStatus @default(DRAFT)
  startDate         DateTime
  endDate           DateTime
  term              Int
  rent              Float
  cam               Float          @default(0)
  deposit           Float
  billingCycle      BillingCycle   @default(MONTHLY)
  paymentTerm       Int            @default(30)
  rentFree          Int            @default(0)
  escalationPercent Float          @default(0)
  managedById       String?
  managedBy         User?          @relation("ManagedContracts", fields: [managedById], references: [id])
  notes             String?

  // GAP #7 — Diện tích HĐT vs thực tế
  contractedArea    Float?         // Diện tích ghi trên hợp đồng (m²)
  actualArea        Float?         // Diện tích thực tế sau đo đạc bàn giao (m²)

  isActive          Boolean        @default(true)
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  files             ContractFile[]
  fitoutProject     FitoutProject?
  invoices          Invoice[]
  billingSchedule   BillingScheduleEntry[]
  amendments        ContractAmendment[]
  events            ContractEvent[]
  templateId        String?
  template          ContractTemplate? @relation(fields: [templateId], references: [id])
  renewalRiskScore  RenewalRiskScore?
  termination       ContractTermination?
}

enum BillingScheduleStatus {
  PENDING
  INVOICED
  SKIPPED
}

model BillingScheduleEntry {
  id          String                @id @default(cuid())
  contractId  String
  contract    Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  period      String
  periodStart DateTime
  periodEnd   DateTime
  rentAmount  Float
  camAmount   Float
  subtotal    Float
  dueDate     DateTime
  status      BillingScheduleStatus @default(PENDING)
  invoiceId   String?               @unique
  invoice     Invoice?              @relation(fields: [invoiceId], references: [id])
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([contractId, period])
  @@index([status, dueDate])
}

model ContractFile {
  id              String    @id @default(cuid())
  contractId      String
  contract        Contract  @relation(fields: [contractId], references: [id])
  fileName        String
  filePath        String
  fileType        String?
  fileSize        Int?
  uploadedById    String?
  sha256Hash      String?
  signedAt        DateTime?
  signerName      String?
  signerRole      String?
  verifyCode      String?   @unique
  createdAt       DateTime  @default(now())
}

model FitoutProject {
  id                 String       @id @default(cuid())
  contractId         String       @unique
  contract           Contract     @relation(fields: [contractId], references: [id])
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  unitId             String
  unit               Unit         @relation(fields: [unitId], references: [id])
  status             String       @default("CONTRACT_SIGNED") // FK to FitoutStageConfig.code
  handoverDate       DateTime?
  startDate          DateTime?
  expectedOpenDate   DateTime?
  actualOpenDate     DateTime?
  operationManagerId String?
  operationManager   User?        @relation("OperationManaged", fields: [operationManagerId], references: [id])
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  checklists         FitoutChecklist[]
  documents          FitoutDocument[]
  milestones         FitoutMilestone[]
  contractors        FitoutContractor[]
  workerLogs         WorkerAccessLog[]
  submittals         FitoutSubmittal[]
  issues             FitoutIssue[]
  dailyReports       FitoutDailyReportEntry[]
  tasks              FitoutTask[]
}

// Cấu hình pipeline giai đoạn fitout — thay cho enum FitoutStatus cứng.
// code giữ nguyên các giá trị enum cũ để tương thích dữ liệu hiện có.
model FitoutStageConfig {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  phaseGroup         String // Nhóm giai đoạn lớn theo flowchart, vd "GD1_KHOI_DAU"
  roleColumn         String // OWNER | COORDINATOR | TENANT — cột chịu trách nhiệm chính theo flowchart
  order              Int
  meetingRequired    Boolean  @default(false)
  triggersUnitStatus String? // UnitStatus cần chuyển khi vào stage này, vd "UNDER_FITOUT"
  setsField          String? // Field trên FitoutProject cần set now(), vd "startDate" | "actualOpenDate"
  colorHex           String   @default("#6b7280")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, order])
}

// Danh mục loại Form/tài liệu fitout — thay cho enum FitoutDocumentType cứng (chỉ 9 loại, không đủ 16 Form của flowchart).
model FitoutFormType {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  category         String   @default("OTHER")
  defaultStageCode String?
  approvalLevels   Int      @default(1)
  approverRoles    Json? // mảng Role theo thứ tự cấp duyệt, vd ["OPERATION","MALL_DIRECTOR"] — độ dài phải khớp approvalLevels
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  submittals       FitoutSubmittal[]

  @@index([isActive, order])
}

// Đệ trình (Submittal) — Form 1-16 theo flowchart, đa cấp duyệt (tái dùng ApprovalWorkflow/ApprovalStep).
model FitoutSubmittal {
  id                String            @id @default(cuid())
  projectId         String
  project           FitoutProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  formTypeId        String
  formType          FitoutFormType    @relation(fields: [formTypeId], references: [id])
  stageCode         String // stage tại thời điểm nộp (denormalized để gate-check tra cứu nhanh)
  title             String
  revisionNo        Int               @default(1)
  parentSubmittalId String?
  parent            FitoutSubmittal?  @relation("SubmittalRevision", fields: [parentSubmittalId], references: [id])
  children          FitoutSubmittal[] @relation("SubmittalRevision")
  status            String            @default("SUBMITTED") // SUBMITTED | IN_PROGRESS | APPROVED | REJECTED | PUBLISHED | OBSOLETED
  workflowId        String?           @unique
  workflow          ApprovalWorkflow? @relation(fields: [workflowId], references: [id])
  submittedById     String
  submittedBy       User              @relation("SubmittalSubmittedBy", fields: [submittedById], references: [id])
  submittedAt       DateTime          @default(now())
  dueDate           DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([projectId, formTypeId])
  @@index([projectId, status])
}

// Vấn đề/Khiếm khuyết (Defect/NCR) — ghim vị trí trên D-Map, workflow Opened→InProgress→Done→Closed/Reopened.
model FitoutIssue {
  id            String        @id @default(cuid())
  projectId     String
  project       FitoutProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId        String
  unit          Unit          @relation(fields: [unitId], references: [id])
  floorId       String?
  title         String
  description   String?
  category      String        @default("DEFECT") // DEFECT | NCR | SAFETY | GENERAL
  severity      String        @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status        String        @default("OPENED") // OPENED | IN_PROGRESS | DONE | CLOSED | REOPENED | CANCELLED
  isOverdue     Boolean       @default(false)
  positionX     Float? // 0-100, toạ độ trong bounding-box của unit (ghim D-Map)
  positionY     Float?
  createdById   String
  createdBy     User          @relation("IssueCreatedBy", fields: [createdById], references: [id])
  assigneeId    String?
  assignee      User?         @relation("IssueAssignedTo", fields: [assigneeId], references: [id])
  dueDate       DateTime?
  closedAt      DateTime?
  reopenCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([projectId, status])
  @@index([unitId, status])
}

// Báo cáo ngày (nhật ký công trường điện tử) — nhiều entry/ngày/nhà thầu, gộp ở tầng đọc.
model FitoutDailyReportEntry {
  id             String        @id @default(cuid())
  projectId      String
  project        FitoutProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportDate     DateTime // chỉ lấy phần ngày (00:00) để group theo ngày
  contractorId   String?
  contractor     FitoutContractor? @relation(fields: [contractorId], references: [id])
  workforceCount Int           @default(0)
  description    String
  areaTag        String? // khu vực trong mặt bằng, vd "Tầng trệt - khu A"
  createdById    String
  createdBy      User          @relation("DailyReportCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  @@index([projectId, reportDate])
}

// Tiến độ thi công (Gantt) — WBS cây con qua parentTaskId, planned/revised/actual.
model FitoutTask {
  id                   String        @id @default(cuid())
  projectId            String
  project              FitoutProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String
  parentTaskId         String?
  parent               FitoutTask?   @relation("TaskWbs", fields: [parentTaskId], references: [id])
  children             FitoutTask[]  @relation("TaskWbs")
  plannedStart         DateTime
  plannedEnd           DateTime
  revisedStart         DateTime?
  revisedEnd           DateTime?
  actualStart          DateTime?
  actualEnd            DateTime?
  percentComplete      Int           @default(0)
  isLate               Boolean       @default(false)
  sortOrder            Int           @default(0)
  assignedContractorId String?
  assignedContractor   FitoutContractor? @relation(fields: [assignedContractorId], references: [id])
  dependsOnTaskId       String?
  dependsOn             FitoutTask?  @relation("TaskDependency", fields: [dependsOnTaskId], references: [id])
  dependents            FitoutTask[] @relation("TaskDependency")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([projectId, sortOrder])
}

// Comment/thread dùng chung cho Submittal, Issue (Phase 3), ... — polymorphic entityType/entityId.
model EntityComment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// Distribution list dùng chung cho Submittal, Issue (Phase 3), ... — polymorphic entityType/entityId.
model EntityDistribution {
  id         String    @id @default(cuid())
  entityType String
  entityId   String
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  notifiedAt DateTime?
  viewedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@unique([entityType, entityId, userId])
  @@index([entityType, entityId])
}

model FitoutChecklist {
  id            String        @id @default(cuid())
  projectId     String
  project       FitoutProject @relation(fields: [projectId], references: [id])
  title         String
  description   String?
  isCompleted   Boolean       @default(false)
  completedById String?
  completedAt   DateTime?
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  unitId       String
  unit         Unit           @relation(fields: [unitId], references: [id])
  type         TicketType
  priority     TicketPriority @default(MEDIUM)
  sla          Int?
  slaDueAt     DateTime?
  subject      String
  description  String?
  createdById  String?
  createdBy    User?          @relation("TicketCreatedBy", fields: [createdById], references: [id])
  source       TicketSource   @default(STAFF_INSPECTION)
  assignedToId String?
  assignedTo   User?          @relation("AssignedTickets", fields: [assignedToId], references: [id])
  status       TicketStatus   @default(NEW)
  resolvedAt   DateTime?
  closedAt     DateTime?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  comments     TicketComment[]
  escalations  TicketEscalation[]
  rating       TicketRating?

  @@index([slaDueAt, status])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// Trạng thái duyệt doanh thu — bền vững trên chính bản ghi, không chỉ nằm trong audit trail.
enum SalesApprovalStatus {
  PENDING
  APPROVED
  DISPUTED
}

model SalesTurnover {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  unitId       String
  unit         Unit                @relation(fields: [unitId], references: [id])
  date         DateTime
  period       String
  grossSales   Float
  netSales     Float
  transactions Int                 @default(0)
  status       SalesApprovalStatus @default(PENDING)
  recordedById String?
  recordedBy   User?               @relation("RecordedBy", fields: [recordedById], references: [id])
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([tenantId, unitId, period])

  auditTrail   SalesAuditTrail[]
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  contractId    String
  contract      Contract      @relation(fields: [contractId], references: [id])
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  period        String
  type          InvoiceType   @default(MONTHLY_RENT)
  status        InvoiceStatus @default(DRAFT)
  subtotal      Float
  vatRate       Float         @default(10)
  vatAmount     Float
  totalAmount   Float
  dueDate       DateTime
  issuedAt      DateTime?
  paidAt        DateTime?
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Huỷ hoá đơn có kiểm soát — không xoá bản ghi, chỉ đánh dấu CANCELLED + lưu vết ai/khi nào/vì sao.
  voidedAt      DateTime?
  voidedById    String?
  voidedBy      User?         @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  voidReason    String?

  lines              InvoiceLine[]
  payments           Payment[]
  billingSchedule    BillingScheduleEntry?
  arDunningLogs      ArDunningLog[]
}

model ArDunningPolicy {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  level          Int
  minDaysOverdue Int
  maxDaysOverdue Int?
  notifyTenant   Boolean  @default(true)
  notifyFinance  Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logs           ArDunningLog[]

  @@index([isActive, level])
}

model ArDunningLog {
  id        String          @id @default(cuid())
  invoiceId String
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  policyId  String
  policy    ArDunningPolicy @relation(fields: [policyId], references: [id])
  level     Int
  sentAt    DateTime        @default(now())

  @@unique([invoiceId, policyId])
  @@index([invoiceId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  type        String
  description String
  qty         Float   @default(1)
  unitPrice   Float
  amount      Float
  order       Int     @default(0)
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  amount    Float
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  paidAt    DateTime
  notes     String?
  createdAt DateTime      @default(now())

  // Đảo bút toán thanh toán ghi nhầm — không xoá bản ghi, chỉ đánh dấu đã đảo + lưu vết.
  reversedAt     DateTime?
  reversedById   String?
  reversedBy     User?     @relation("PaymentReversedBy", fields: [reversedById], references: [id])
  reversalReason String?
}

model SapIntegrationLog {
  id             String    @id @default(cuid())
  entityType     String
  entityId       String
  endpoint       String
  payload        String
  response       String?
  status         SapStatus @default(PENDING)
  retryCount     Int       @default(0)
  errorMessage   String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model DealScoreCriterion {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  fieldSource String
  weight      Float    @default(1)
  minScore    Float    @default(0)
  maxScore    Float    @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProposalDealScore {
  id         String   @id @default(cuid())
  proposalId String   @unique
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  totalScore Float
  grade      String
  breakdown  Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContractTemplate {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  contractType ContractType @default(LEASE_AGREEMENT)
  content      String       @db.Text
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  clauses   ContractClause[]
  contracts Contract[]
}

model ContractClause {
  id         String           @id @default(cuid())
  templateId String
  template   ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  code       String
  title      String
  content    String           @db.Text
  order      Int              @default(0)
  isRequired Boolean          @default(true)
  createdAt  DateTime         @default(now())

  @@unique([templateId, code])
}

model ContractAmendment {
