  mallId       String
  mall         Mall     @relation(fields: [mallId], references: [id])
  serviceCode  String
  name         String // Tn dch v: "LED screen", "Escalator wrap", "MKT support"...
  unit         String // n v tnh: "m2", "thng", "k", "ln"
  defaultPrice Float // Gi mc nh
  currency     String   @default("VND")
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  proposalServices ProposalService[]

  @@unique([mallId, serviceCode])
  @@index([mallId, isActive])
}

model ProposalService {
  id               String               @id @default(cuid())
  proposalId       String
  proposal         Proposal             @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  serviceCatalogId String?
  serviceCatalog   ServicePriceCatalog? @relation(fields: [serviceCatalogId], references: [id])
  serviceCode      String
  name             String
  quantity         Float                @default(1)
  unit             String
  unitPrice        Float
  totalPrice       Float
  currency         String               @default("VND")
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([proposalId])
}

model ApprovalWorkflow {
  id         String         @id @default(cuid())
  entityType String
  entityId   String
  proposalId String?        @unique
  proposal   Proposal?      @relation(fields: [proposalId], references: [id])
  status     WorkflowStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  steps           ApprovalStep[]
  fitoutSubmittal FitoutSubmittal?
}

model ApprovalStep {
  id           String           @id @default(cuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  stepOrder    Int
  stepName     String
  approverRole Role
  approverId   String?
  approver     User?            @relation(fields: [approverId], references: [id])
  status       StepStatus       @default(PENDING)
  comment      String?
