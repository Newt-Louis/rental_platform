  syncStatus     String   @default("SYNCED") // SYNCED | PENDING | FAILED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, syncStatus])
}

