  mallId      String
  mall        Mall      @relation(fields: [mallId], references: [id])
  fileName    String
  filePath    String
  fileType    String    @default("pdf")
  fileSizeKb  Int       @default(0)
  version     Int       @default(1)
  status      String    @default("PENDING")
  analysis    Json?
  suggestions Json?
  appliedAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// WAVE 4 - Operations & Fitout
// ═══════════════════════════════════════════════════════════════════════════════

enum FitoutDocumentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model FitoutDocument {
  id            String               @id @default(cuid())
  projectId     String
  project       FitoutProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentType  String // FK to FitoutFormType.code
  fileName      String
  filePath      String
  fileSizeKb    Int                  @default(0)
  status        FitoutDocumentStatus @default(PENDING)
  requiredFor   String? // FK to FitoutStageConfig.code
  uploadedById  String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([projectId, documentType])
}

model FitoutDocumentGate {
  id           String   @id @default(cuid())
  stage        String // FK to FitoutStageConfig.code
  documentType String // FK to FitoutFormType.code
  isRequired   Boolean  @default(true)
  description  String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([stage, documentType])
}

model FitoutSlaPolicy {
  id             String   @id @default(cuid())
  stage          String   @unique // FK to FitoutStageConfig.code
  targetDays     Int
  warningDays    Int
  escalateToRole Role?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FitoutMilestone {
  id          String        @id @default(cuid())
  projectId   String
  project     FitoutProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       String // FK to FitoutStageConfig.code
  startedAt   DateTime
  completedAt DateTime?
  targetDate  DateTime?
  slaDays     Int?
  isOverdue   Boolean       @default(false)
  escalatedAt DateTime?
  notes       String?

  @@unique([projectId, stage])
  @@index([isOverdue])
}

model TicketSlaPolicy {
  id             String         @id @default(cuid())
  ticketType     TicketType
  priority       TicketPriority
  responseHours  Int
  resolutionHours Int
  escalateToRole Role?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([ticketType, priority])
}

model TicketEscalation {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  level       Int
  reason      String
  escalatedTo String?
  notifiedAt  DateTime @default(now())

  @@index([ticketId])
}

