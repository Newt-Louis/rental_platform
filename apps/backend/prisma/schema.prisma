// ===========================================================================
// CATEGORY MASTER DATA
// ===========================================================================

model Category {
  id          String     @id @default(cuid())
  code        String     @unique // "FNB", "FASHION", "BEAUTY"
  name        String // "F&B", "Fashion", "Beauty & Wellness"
  description String?
  parentId    String? // For sub-categories
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  units            Unit[]
  tenants          Tenant[]
  leads            Lead[]
  customers        Customer[]
  categoryPricings CategoryMallPricing[]

  @@index([code])
  @@index([parentId])
  @@index([isActive, sortOrder])
}

model CategoryMallPricing {
  id         String   @id @default(cuid())
  mallId     String
  mall       Mall     @relation(fields: [mallId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  floorId    String?
  floor      Floor?   @relation(fields: [floorId], references: [id])
  zoneId     String?
  zone       Zone?    @relation(fields: [zoneId], references: [id])

  // Price range (VND/m2/month)
  // Null on a floor/zone override means "inherit from the next applicable rule".
  // Mall-wide base rules are still required to provide min/max by service validation.
  minRentPerSqm Float? // Gi sn
  maxRentPerSqm Float? // Gi trn
  suggestedRent Float? // Gi  xut (tham kho)

  // CAM pricing
  camPerSqm Float? // Null = inherit; zero is an explicit free CAM value

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // Null = v thi hn
  notes         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  createdBy     User?     @relation("CategoryPricingCreatedBy", fields: [createdById], references: [id])

  @@unique([mallId, categoryId, floorId, zoneId, effectiveFrom])
  @@index([mallId, categoryId, isActive])
  @@index([effectiveFrom, effectiveTo])
}

