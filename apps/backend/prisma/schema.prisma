model ApprovalPolicyRule {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  stepName      String
  stepOrder     Int
  approverRole  Role
  conditionType String
  operator      String?
  threshold     Float?
  matchValue    String?
  isRequired    Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, stepOrder])
}

model Contract {
  id                String         @id @default(cuid())
  contractNumber    String         @unique
  proposalId        String?        @unique
  proposal          Proposal?      @relation(fields: [proposalId], references: [id])
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  unitId            String
  unit              Unit           @relation(fields: [unitId], references: [id])
  type              ContractType   @default(LEASE_AGREEMENT)
  status            ContractStatus @default(DRAFT)
  startDate         DateTime
  endDate           DateTime
  term              Int
  rent              Float
  cam               Float          @default(0)
  deposit           Float
  billingCycle      BillingCycle   @default(MONTHLY)
  paymentTerm       Int            @default(30)
  rentFree          Int            @default(0)
  escalationPercent Float          @default(0)
  managedById       String?
  managedBy         User?          @relation("ManagedContracts", fields: [managedById], references: [id])
  notes             String?

  // GAP #7 -- Din tch HT vs thc t
  contractedArea Float? // Din tch ghi trn hp ng (m2)
  actualArea     Float? // Din tch thc t sau o c bn giao (m2)

  // GAP #41 -- Tch 3 khon cc (carry-over t Proposal khi convert)
  depositLease  Float? // Tin cc thu (VND)
  depositFitout Float  @default(0) // Cc thi cng (VND)
  fitoutFee     Float  @default(0) // Ph thi cng (VND)

  // GAP #91, #93 -- Ph tin ch & ph ngoi gi
  utilityFee     Float   @default(0) // Ph tin ch (VND/thng)
  afterHoursFee  Float   @default(0) // Ph ngoi gi (VND/gi)
  operatingHours String? // Gi hot ng

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  files            ContractFile[]
  fitoutProject    FitoutProject?
  invoices         Invoice[]
  billingSchedule  BillingScheduleEntry[]
  amendments       ContractAmendment[]
  events           ContractEvent[]
  templateId       String?
  template         ContractTemplate?      @relation(fields: [templateId], references: [id])
  renewalRiskScore RenewalRiskScore?
  termination      ContractTermination?
}

enum BillingScheduleStatus {
  PENDING
  INVOICED
  SKIPPED
}

model BillingScheduleEntry {
