// t ch slot - bc gia Lead quan tm v Proposal chnh thc
// Cho php nhiu khch cng book mt unit vi th t u tin
model UnitBooking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique // BK-YYYY-NNNNN
  unitId        String
  unit          Unit          @relation(fields: [unitId], references: [id])
  leadId        String?
  lead          Lead?         @relation(fields: [leadId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  status        BookingStatus @default(PENDING)
  priority      Int           @default(1) // 1 = u tin cao nht
  requestedArea Float? // Din tch yu cu
  requestedTerm Int? // Thi hn thu mong mun (thng)
  expectedRent  Float? // Mc gi k vng (khch)
  holdDays      Int           @default(30) // S ngy gi slot
  expiresAt     DateTime? // Thi im booking ht hn
  activatedAt   DateTime? // Thi im chuyn sang ACTIVE
  convertedAt   DateTime? // Thi im convert sang Proposal
  cancelledAt   DateTime?
  cancelReason  String?
  notes         String?

  // Proposed price by sales
  proposedRentPerSqm    Float? // Gi sale  xut (VND/m2/thng)
  proposedCamPerSqm     Float? // CAM  xut
  priceApprovalStatus   PriceApprovalStatus? // PENDING, APPROVED, REJECTED
  priceApprovalNote     String? // Ghi ch ph duyt
  priceApprovedById     String?
  priceApprovedBy       User?                @relation("BookingPriceApprover", fields: [priceApprovedById], references: [id])
  priceApprovedAt       DateTime?
  priceDeviationPercent Float? // % chnh lch so vi gi sn
  pricingRuleId          String? // Rule version used for the latest validation
  pricingSnapshot        Json?   // Effective pricing values and inheritance sources

  createdById  String
  createdBy    User     @relation("BookingCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("BookingAssignedTo", fields: [assignedToId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  proposal   Proposal?
  activities BookingActivity[]

  @@index([unitId, status, priority])
  @@index([leadId])
  @@index([customerId])
  @@index([status, expiresAt])
  @@index([priceApprovalStatus])
}

