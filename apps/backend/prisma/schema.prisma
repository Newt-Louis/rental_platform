// Unit Slots - Sub-areas within units for short-term rentals
enum SlotType {
  SHORT_TERM
  LONG_TERM
  FLEXIBLE
}

enum SlotBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model UnitSlot {
  id               String    @id @default(cuid())
  unitId           String
  unit             Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  code             String
  name             String
  area             Float
  description      String?
