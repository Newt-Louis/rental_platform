}

// ═══════════════════════════════════════════════════════════════════════════════
// WAVE 6 - Multi-Mall Governance & Operations Excellence
// ═══════════════════════════════════════════════════════════════════════════════

// Phân quyền người dùng theo từng Mall (multi-mall governance)
model UserMallAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mallId    String
  mall      Mall     @relation(fields: [mallId], references: [id], onDelete: Cascade)
  role      Role
  isActive  Boolean  @default(true)
  grantedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mallId])
  @@index([mallId, isActive])
  @@index([userId, isActive])
}

// Reminder follow-up cho Lead/Customer
model LeadFollowUp {
  id           String    @id @default(cuid())
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User      @relation("FollowUpAssigned", fields: [assignedToId], references: [id])
  dueDate      DateTime
  note         String?
  isDone       Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([assignedToId, isDone, dueDate])
  @@index([dueDate, isDone])
}

// Nhiều kịch bản tài chính cho một Proposal
model ProposalScenario {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSelected  Boolean  @default(false)
  terms       Json     // { area, term, rentPerSqm, camPerSqm, deposit, rentFree, escalation, discount, monthlyRent, totalValue }
  score       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([proposalId])
}

// Quy trình chấm dứt hợp đồng
model ContractTermination {
  id                String    @id @default(cuid())
  contractId        String    @unique
  contract          Contract  @relation(fields: [contractId], references: [id])
  initiatedBy       String    // 'THISO' | 'TENANT'
  reason            String
  effectiveDate     DateTime
  noticePeriodDays  Int       @default(60)
  depositRefund     Float?
  penaltyAmount     Float?
  handoverDate      DateTime?
  handoverCondition String?   // 'GOOD' | 'FAIR' | 'DAMAGED'
  utilityFinalRead  Json?     // { electricity, water, gas }
  accessCardReturn  Boolean   @default(false)
  signageRemoved    Boolean   @default(false)
  keysReturned      Boolean   @default(false)
  status            String    @default("INITIATED") // INITIATED | IN_PROGRESS | COMPLETED | CANCELLED
  completedAt       DateTime?
  notes             String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Nhà thầu thi công cho Fitout
model FitoutContractor {
  id           String        @id @default(cuid())
  projectId    String
  project      FitoutProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  companyName  String
  licenseNo    String?
  contactName  String
  phone        String
  email        String?
  startDate    DateTime
  endDate      DateTime?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  workers      WorkerAccessLog[]
  dailyReports FitoutDailyReportEntry[]
  tasks        FitoutTask[]

  @@index([projectId, isActive])
}

// Log ra vào công trường thi công
model WorkerAccessLog {
  id           String           @id @default(cuid())
  projectId    String
  project      FitoutProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractorId String
  contractor   FitoutContractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  workerName   String
  idNumber     String
  entryDate    DateTime
  exitDate     DateTime?
  purpose      String?
  createdAt    DateTime         @default(now())

  @@index([projectId, entryDate])
  @@index([contractorId])
}

// Lịch bảo trì định kỳ (preventive maintenance)
model MaintenanceSchedule {
  id              String     @id @default(cuid())
  mallId          String
  mall            Mall       @relation(fields: [mallId], references: [id])
  unitId          String?
  unit            Unit?      @relation(fields: [unitId], references: [id])
  title           String
  description     String?
  frequency       String     // 'DAILY' | 'WEEKLY' | 'MONTHLY' | 'QUARTERLY' | 'ANNUALLY'
  nextDueDate     DateTime
  lastExecutedAt  DateTime?
  assignedRole    Role       @default(OPERATION)
  estimatedHours  Float?
  isActive        Boolean    @default(true)
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([mallId, nextDueDate, isActive])
}

// Đánh giá satisfaction của tenant sau khi đóng ticket
model TicketRating {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  comment   String?
  ratedAt   DateTime @default(now())

  @@index([rating])
}

// Audit trail cho báo cáo doanh thu của tenant
model SalesAuditTrail {
  id            String        @id @default(cuid())
  salesId       String
  sales         SalesTurnover @relation(fields: [salesId], references: [id], onDelete: Cascade)
  action        String        // 'SUBMITTED' | 'REVISED' | 'APPROVED' | 'DISPUTED'
  oldValue      Float?
  newValue      Float
  reason        String?
  performedById String
  performedBy   User          @relation("SalesAuditBy", fields: [performedById], references: [id])
  performedAt   DateTime      @default(now())

  @@index([salesId])
}

// Thông báo từ ban quản lý mall gửi đến tất cả tenant
model MallAnnouncement {
  id               String    @id @default(cuid())
  mallId           String
  mall             Mall      @relation(fields: [mallId], references: [id])
  title            String
  content          String    @db.Text
  category         String    // 'MAINTENANCE' | 'EVENT' | 'POLICY' | 'PROMOTION' | 'EMERGENCY'
  priority         String    @default("NORMAL") // 'LOW' | 'NORMAL' | 'HIGH' | 'URGENT'
  publishedAt      DateTime
  expiresAt        DateTime?
  targetAll        Boolean   @default(true)
  targetCategories String[]  // filter theo ngành hàng của tenant
  attachmentUrl    String?
  isActive         Boolean   @default(true)
  createdById      String
  createdBy        User      @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([mallId, isActive, publishedAt])
}

// Document hub tập trung — thay thế rải rác ContractFile, FitoutDocument
model UnifiedDocument {
  id            String    @id @default(cuid())
  mallId        String?
  mall          Mall?     @relation(fields: [mallId], references: [id])
  entityType    String    // 'CONTRACT' | 'FITOUT' | 'TENANT' | 'INVOICE' | 'TICKET' | 'PROPOSAL'
  entityId      String
  category      String    @default("GENERAL") // 'ORIGINAL' | 'SCAN' | 'AMENDMENT' | 'CORRESPONDENCE' | 'SIGNED'
  documentType  String    // loại tài liệu cụ thể
  fileName      String
  filePath      String
  fileHash      String?   // SHA-256 để verify integrity
  fileSize      Int       @default(0)
  mimeType      String    @default("application/octet-stream")
  version       Int       @default(1)
  isLatest      Boolean   @default(true)
  retentionYear Int       @default(10)
  deleteAfter   DateTime?
  signedAt      DateTime?
  signedBy      String?
  uploadedById  String
  uploadedBy    User      @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt    DateTime  @default(now())
  downloadCount Int       @default(0)
  isActive      Boolean   @default(true)

  @@index([entityType, entityId])
  @@index([mallId, documentType])
  @@index([uploadedAt])
}

// Mapping entity trong hệ thống sang đối tượng tương ứng trong SAP
model SapEntityMapping {
  id           String   @id @default(cuid())
  entityType   String   // 'TENANT' | 'CONTRACT' | 'INVOICE' | 'PAYMENT'
  entityId     String
  sapRef       String   // BP number / doc number trong SAP
  sapSystem    String   @default("S4HANA")
  sapCompanyCode String @default("1000")
  lastSyncAt   DateTime @default(now())
  syncStatus   String   @default("SYNCED") // SYNCED | PENDING | FAILED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, syncStatus])
}

// ─────────────────────────────────────────────────────
// BOOKING & SLOT MANAGEMENT
// ─────────────────────────────────────────────────────

// Đặt chỗ slot - bước giữa Lead quan tâm và Proposal chính thức
// Cho phép nhiều khách cùng book một unit với thứ tự ưu tiên
model UnitBooking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique  // BK-YYYY-NNNNN
  unitId          String
  unit            Unit          @relation(fields: [unitId], references: [id])
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  status          BookingStatus @default(PENDING)
  priority        Int           @default(1)  // 1 = ưu tiên cao nhất
  requestedArea   Float?        // Diện tích yêu cầu
  requestedTerm   Int?          // Thời hạn thuê mong muốn (tháng)
  expectedRent    Float?        // Mức giá kỳ vọng (khách)
  holdDays        Int           @default(30) // Số ngày giữ slot
  expiresAt       DateTime?     // Thời điểm booking hết hạn
  activatedAt     DateTime?     // Thời điểm chuyển sang ACTIVE
  convertedAt     DateTime?     // Thời điểm convert sang Proposal
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?

  // Proposed price by sales
  proposedRentPerSqm    Float?                  // Giá sale đề xuất (VND/m²/tháng)
  proposedCamPerSqm     Float?                  // CAM đề xuất
  priceApprovalStatus   PriceApprovalStatus?    // PENDING, APPROVED, REJECTED
  priceApprovalNote     String?                 // Ghi chú phê duyệt
  priceApprovedById     String?
  priceApprovedBy       User?         @relation("BookingPriceApprover", fields: [priceApprovedById], references: [id])
  priceApprovedAt       DateTime?
  priceDeviationPercent Float?                  // % chênh lệch so với giá sàn

  createdById     String
  createdBy       User          @relation("BookingCreatedBy", fields: [createdById], references: [id])
  assignedToId    String?
  assignedTo      User?         @relation("BookingAssignedTo", fields: [assignedToId], references: [id])
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  proposal        Proposal?
  activities      BookingActivity[]

  @@index([unitId, status, priority])
  @@index([leadId])
  @@index([customerId])
  @@index([status, expiresAt])
  @@index([priceApprovalStatus])
}

// Lịch sử hoạt động của một booking
model BookingActivity {
  id          String              @id @default(cuid())
  bookingId   String
  booking     UnitBooking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type        BookingActivityType
  note        String
  metadata    Json?               // Dữ liệu bổ sung (ví dụ: priority cũ/mới)
  performedById String
  performedBy   User              @relation(fields: [performedById], references: [id])
  createdAt   DateTime            @default(now())

  @@index([bookingId, createdAt])
}

// Media/tài liệu gắn với từng unit: ảnh, floor plan, video, brochure
model UnitMedia {
  id           String        @id @default(cuid())
  unitId       String
  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  type         UnitMediaType @default(PHOTO)
  fileUrl      String        // Đường dẫn file (local path hoặc CDN URL)
  fileName     String
  fileSize     Int?          // Byte
  mimeType     String?
  caption      String?       // Mô tả ngắn hiển thị trong gallery
  sortOrder    Int           @default(0)  // Thứ tự hiển thị
  isCover      Boolean       @default(false) // Ảnh đại diện của unit
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([unitId, type, sortOrder])
}

// Phase 2: Unit History tracking
enum UnitHistoryType {
  STATUS_CHANGE
  RENT_CHANGE
  TENANT_CHANGE
  INFO_UPDATE
  CONDITION_CHANGE
}

model UnitHistory {
  id           String          @id @default(cuid())
  unitId       String
  unit         Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  changeType   UnitHistoryType
  fieldName    String?         // Field that changed (e.g., 'status', 'baseRentPerSqm')
  oldValue     Json?           // Previous value
  newValue     Json?           // New value
  changedById  String?
  changedBy    User?           @relation("UnitHistoryChangedBy", fields: [changedById], references: [id])
  notes        String?
  createdAt    DateTime        @default(now())

  @@index([unitId, createdAt])
  @@index([changeType])
}

// Log import dữ liệu unit hàng loạt (upload CSV/Excel)
model UnitImportLog {
  id           String   @id @default(cuid())
  mallId       String
  fileName     String
  totalRows    Int      @default(0)
  successRows  Int      @default(0)
  failedRows   Int      @default(0)
  errors       Json?    // Danh sách lỗi theo dòng
  status       String   @default("PROCESSING") // PROCESSING | COMPLETED | FAILED
  importedById String
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([mallId, createdAt])
}

// Unit Slots - Sub-areas within units for short-term rentals
enum SlotType {
  SHORT_TERM
  LONG_TERM
  FLEXIBLE
}

enum SlotBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model UnitSlot {
  id               String     @id @default(cuid())
  unitId           String
  unit             Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  code             String
  name             String
  area             Float
  description      String?
  slotType         SlotType?  @default(FLEXIBLE)
  pricePerDaySqm   Float?
  pricePerHour     Float?
  pricePerSqmMonth Float?
  posX             Float?     @default(10)
  posY             Float?     @default(10)
  posW             Float?     @default(20)
  posH             Float?     @default(20)
  fillColor        String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  pricingRules     SlotPricingRule[]
  bookings         SlotBooking[]

  @@unique([unitId, code])
  @@index([unitId, isActive])
}

model SlotPricingRule {
  id          String    @id @default(cuid())
  slotId      String
  slot        UnitSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  name        String
  ruleType    String    // WEEKEND, HOLIDAY, SEASONAL, MIN_DAYS
  multiplier  Float?    @default(1)
  discountPct Float?    @default(0)
  minDays     Int?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slotId, isActive])
}

model SlotBooking {
  id            String            @id @default(cuid())
  bookingRef    String            @unique
  slotId        String
  slot          UnitSlot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  leadId        String?
  lead          Lead?             @relation(fields: [leadId], references: [id])
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id])
  type          String            // DAILY, HOURLY, MONTHLY
  startDatetime DateTime
  endDatetime   DateTime
  totalArea     Float?
  baseAmount    Float?
  discountPct   Float?            @default(0)
  totalAmount   Float             // Final amount after discount
  status        SlotBookingStatus @default(PENDING)
  notes         String?
  cancelReason  String?
  createdById   String?
  createdBy     User?             @relation("SlotBookedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([slotId, status])
  @@index([startDatetime, endDatetime])
}

// Cấu hình thương hiệu hiển thị ở màn hình đăng nhập (logo + ảnh nền) — bảng singleton,
// luôn chỉ có 1 dòng, service tự tạo dòng đầu tiên nếu chưa có.
model BrandingSettings {
  id            String   @id @default(cuid())
  logoUrl       String?
  backgroundUrl String?
  updatedById   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}
