enum FitoutDocumentType {
  DESIGN_DRAWING
  MEP_DRAWING
  FIRE_SAFETY_CERT
  PCCC_APPROVAL
  CONSTRUCTION_PERMIT
  INSURANCE_CERT
  INSPECTION_REPORT
  HANDOVER_FORM
  OTHER
}

enum FitoutDocumentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model FitoutDocument {
  id            String               @id @default(cuid())
  projectId     String
  project       FitoutProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentType  FitoutDocumentType
  fileName      String
  filePath      String
  fileSizeKb    Int                  @default(0)
  status        FitoutDocumentStatus @default(PENDING)
  requiredFor   FitoutStatus?
  uploadedById  String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([projectId, documentType])
}

model FitoutDocumentGate {
  id           String             @id @default(cuid())
  stage        FitoutStatus
  documentType FitoutDocumentType
  isRequired   Boolean            @default(true)
  description  String?
  order        Int                @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())

  @@unique([stage, documentType])
}

model FitoutSlaPolicy {
  id             String       @id @default(cuid())
  stage          FitoutStatus @unique
  targetDays     Int
  warningDays    Int
  escalateToRole Role?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model FitoutMilestone {
  id          String        @id @default(cuid())
  projectId   String
  project     FitoutProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       FitoutStatus
  startedAt   DateTime
  completedAt DateTime?
  targetDate  DateTime?
  slaDays     Int?
  isOverdue   Boolean       @default(false)
  escalatedAt DateTime?
  notes       String?

  @@unique([projectId, stage])
  @@index([isOverdue])
}

model TicketSlaPolicy {
  id             String         @id @default(cuid())
  ticketType     TicketType
  priority       TicketPriority
  responseHours  Int
  resolutionHours Int
  escalateToRole Role?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

