# UAT preflight-check environment template. See
# docs/security/SECRET_INCIDENT_REMEDIATION.md — the real artifacts/uat-preflight.env
# was committed with live credentials and has been untracked/removed from history.

POSTGRES_USER=leasing
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=leasing_platform
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=3000
FRONTEND_PORT=8080

JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://uat.example.com
VITE_API_URL=

ALLOW_PUBLIC_REGISTER=false
SEED_DATABASE=false
SAP_ENABLED=false
